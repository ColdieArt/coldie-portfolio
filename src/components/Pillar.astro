---
import { pillars, type PillarKey } from '../data/site';
import { featuredAllFor, curatedFor } from '../data/works';
import RansomHeading from './RansomHeading.astro';
import DepthParallax from './DepthParallax.astro';
import CollageBuilder from './CollageBuilder.astro';
import WorkCard from './WorkCard.astro';

export interface Props { pillar: PillarKey; index: number; }
const { pillar, index } = Astro.props;
const meta = pillars[pillar];
const featuredList = featuredAllFor(pillar);
const curated = curatedFor(pillar);
const num = String(index).padStart(2, '0');
---

<section class="pillar" aria-labelledby={`pillar-${pillar}`}>
  <div class="wrap">
    <header class="pillar__head">
      <RansomHeading as="h3" id={`pillar-${pillar}`} text="3D Kinetic magnetic portraits" size="clamp(2.6rem, 11vw, 10rem)" />
      {'statement' in meta && meta.statement && <p class="pillar__statement">{meta.statement}</p>}
    </header>

    {featuredList.map((featured) => (
      <figure class="pillar__featured">
        <div class="pillar__stage">
          {pillar === 'stereoscopic' && featured.layers && (
            <DepthParallax layers={featured.layers} ratio="4/5" amplitude={22} />
          )}
          {pillar === 'kinetic' && (
            <a href={`/work/${featured.slug}`}>
              <img class="pillar__img" src={featured.image ?? '/works/placeholder/portrait.svg'} alt={featured.imageAlt ?? featured.title} loading="lazy" decoding="async" />
            </a>
          )}
          {pillar === 'participatory' && <CollageBuilder ratio="4/5" />}
        </div>
        <figcaption class="pillar__cap">
          <p class="pillar__cap-title"><a href={`/work/${featured.slug}`}>{featured.title}</a> <span class="muted">({featured.year})</span></p>
          <p class="muted small">{featured.medium}{featured.dimensions ? ` · ${featured.dimensions}` : ''}</p>
          <p class="pillar__cap-text">{featured.caption}</p>
          <a class="link-arrow" href={`/work/${featured.slug}`}>View this work</a>
        </figcaption>
      </figure>
    ))}

    {curated.length > 0 && (
      <div class="pillar__curated">
        {curated.slice(0, 3).map((w) => <WorkCard work={w} />)}
      </div>
    )}

    <div class="pillar__all">
      {pillar === 'stereoscopic' ? (
        <a class="link-arrow" href="/collection">View the collection</a>
      ) : (
        <a class="link-arrow" href={`/${meta.slug}`}>View all {meta.title.toLowerCase()}</a>
      )}
    </div>
  </div>
</section>

<style>
  .pillar { padding-block: clamp(3.5rem, 8vw, 7rem); border-top: 1px solid var(--line-soft); }
  .pillar__head { max-width: none; text-align: center; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .pillar__concept {
    font-family: var(--display); text-transform: uppercase;
    font-size: clamp(1.4rem, 3vw, 2.2rem); line-height: 1; letter-spacing: 0.01em;
    color: var(--red); margin: 0 0 0.5em;
  }
  .pillar__title { margin: 0 0 0.4em; }
  .pillar__framing { margin: 0; }
  .pillar__statement {
    margin: 1.1em 0 0; color: var(--ink-soft);
    font-family: var(--serif); font-style: italic;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.5;
  }

  .pillar__featured {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
    margin: 0 0 clamp(2.5rem, 6vw, 4.5rem);
  }
  /* 560px on laptops; on big screens grow with the viewport so the work still fits on screen */
  .pillar__stage { max-width: max(560px, calc((100vh - 10rem) * 0.8)); width: 100%; justify-self: center; }
  .pillar__img { width: 100%; height: auto; display: block; border-radius: var(--radius); border: 1px solid var(--line-soft); background: var(--bg-raise); }
  .pillar__cap-title { font-family: var(--serif); font-size: 1.5rem; margin: 0 0 0.2em; }
  .pillar__cap-title a { text-decoration: none; }
  .pillar__cap-title a:hover { color: var(--accent); }
  .pillar__cap-text { margin: 1em 0 1.4em; color: var(--ink-soft); }

  .pillar__curated {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .pillar__all { }

  @media (max-width: 860px) {
    .pillar__featured { grid-template-columns: 1fr; }
    .pillar__stage { max-width: 460px; margin-inline: auto; }
  }
  @media (max-width: 620px) {
    .pillar__curated { grid-template-columns: 1fr 1fr; }
  }
</style>
