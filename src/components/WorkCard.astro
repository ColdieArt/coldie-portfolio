---
import type { Work } from '../data/works';
export interface Props { work: Work; }
const { work } = Astro.props;
const img = work.image ?? work.layers?.[work.layers.length - 1]?.src ?? '/works/placeholder/portrait.svg';
const alt = work.imageAlt ?? `${work.title} (${work.year})`;
---
<a class="card" href={`/work/${work.slug}`}>
  <span class="card__frame">
    <img src={img} alt={alt} loading="lazy" decoding="async" />
  </span>
  <span class="card__meta">
    <span class="card__title">{work.title}</span>
    <span class="card__sub muted small">{work.year} · {work.artform}</span>
  </span>
</a>

<style>
  .card { text-decoration: none; display: block; }
  .card__frame {
    display: block; overflow: hidden; border-radius: var(--radius);
    background: var(--bg-raise); border: 1px solid var(--line-soft);
  }
  .card__frame img {
    width: 100%; aspect-ratio: 4/5; object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22,0.61,0.36,1);
  }
  .card:hover .card__frame img { transform: scale(1.03); }
  .card__meta { display: block; margin-top: 0.9em; }
  .card__title { font-family: var(--serif); font-size: 1.15rem; }
  .card:hover .card__title { color: var(--accent); }
  .card__sub { display: block; margin-top: 0.15em; }
  @media (prefers-reduced-motion: reduce) { .card__frame img { transition: none; } }
</style>
