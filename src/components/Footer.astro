---
import { site } from '../data/site';
import { provenance } from '../data/site';
const year = 2026; // build year; static by design
const commissionMailto = `mailto:${site.inquiryEmail}?subject=${encodeURIComponent('Commission inquiry')}`;
---
<footer class="foot section--flat">
  <div class="wrap foot__ctas">
    <div class="foot__cta">
      <p class="foot__cta-h">Looking For Something Else</p>
      <p class="foot__cta-text">I have a studio and archive of lots of art not shown here.</p>
      <a class="btn btn--solid foot__cta-btn" href="/archive">See the archive →</a>
    </div>
    <div class="foot__cta">
      <p class="foot__cta-h">Commissions</p>
      <p class="foot__cta-text">Interested in a custom piece from your home, office, or public space? Let’s talk.</p>
      <a class="btn btn--solid foot__cta-btn" href={commissionMailto}>Let’s talk →</a>
    </div>
    <div class="foot__cta">
      <p class="foot__cta-h">Stay in the Loop</p>
      <p class="foot__cta-text">New drops, exhibitions and releases — straight to your inbox. No spam.</p>
      <a class="btn btn--solid foot__cta-btn" href={site.contactListUrl} target="_blank" rel="noopener">Sign up ↗</a>
    </div>
  </div>
  <div class="wrap foot__grid">
    <div>
      <p class="foot__name">Coldie</p>
      <p class="muted small">{site.oneLineBio}</p>
    </div>
    <nav class="foot__col" aria-label="Sections">
      <p class="foot__h">Explore</p>
      <a href="/#featured-digital">Digital</a>
      <a href="/#current-series">Eterno Gallery</a>
      <a href="/where-im-going#filthy-fiat">Filthy Fiat</a>
      <a href="/where-im-going#work">Touch the Art</a>
      <a href="/#pioneer">Stereo 3D</a>
      <a href="/kinetic">Kinetic portraits</a>
      <a href={site.storeUrl} target="_blank" rel="noopener">Store</a>
      <a href="/archive">Archive</a>
      <a href="/faq">FAQ</a>
    </nav>
    <nav class="foot__col" aria-label="Provenance">
      <p class="foot__h">Provenance</p>
      {provenance.slice(0, 6).map((p) => (
        <a
          href={p.href}
          aria-label={p.aria}
          title={p.aria}
          {...(p.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
        >{p.label}</a>
      ))}
    </nav>
    <div class="foot__col">
      <p class="foot__h">Inquire</p>
      <a href="/#acquire">Acquire a work</a>
      <a href={`mailto:${site.inquiryEmail}`}>{site.inquiryEmail}</a>
      <a href={site.social.instagram} rel="me">Instagram</a>
      <a href={site.social.x} rel="me">X</a>
    </div>
  </div>
  <div class="wrap foot__base small muted">
    <span>© {year} {site.name}. All works © the artist.</span>
    <span>{site.location}</span>
  </div>
</footer>

<style>
  .foot { padding-block: clamp(3rem, 7vw, 5rem) 2rem; border-top: 1px solid var(--line-soft); }
  /* Three CTA boxes across one row above the footer columns. */
  .foot__ctas {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.2vw, 1.5rem); margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .foot__cta {
    display: flex; flex-direction: column; align-items: flex-start;
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: clamp(1.2rem, 2.4vw, 1.75rem); background: var(--bg-raise);
  }
  .foot__cta-h { font-family: var(--serif); font-size: clamp(1.1rem, 1.8vw, 1.35rem); margin: 0; color: var(--ink); line-height: 1.15; }
  .foot__cta-text { margin: 0.4em 0 1.2em; font-size: 0.85rem; color: var(--ink-soft); }
  .foot__cta-btn { margin-top: auto; white-space: nowrap; }
  @media (max-width: 760px) { .foot__ctas { grid-template-columns: 1fr; } }
  .foot__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .foot__name { font-family: var(--serif); font-size: 1.5rem; margin: 0 0 0.5em; }
  .foot__col { display: flex; flex-direction: column; gap: 0.5em; }
  .foot__h {
    font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-mute); margin: 0 0 0.4em;
  }
  .foot__col a { font-size: 0.9rem; color: var(--ink-soft); text-decoration: none; }
  .foot__col a:hover { color: var(--ink); }
  .foot__base {
    display: flex; justify-content: space-between; gap: 1rem;
    margin-top: clamp(2rem, 5vw, 3.5rem); padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
  }
  @media (max-width: 760px) {
    .foot__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 460px) {
    .foot__grid { grid-template-columns: 1fr; }
    .foot__base { flex-direction: column; }
  }
</style>
