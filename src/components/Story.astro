---
// "In his own words" — interviews across his career in a spacious two-column index
// (the 2011 first interview lives on /where-ive-been, under Stereoscopic Fine Art). Facade embeds (YouTubeLite) keep it
// clean and gallery-grade. The interviews themselves live in data/videos.ts.
import YouTubeLite from './YouTubeLite.astro';
import RansomHeading from './RansomHeading.astro';
import { interviews } from '../data/videos';
---
<section id="story" class="story" aria-labelledby="story-h">
  <div class="wrap">
    <header class="story__head">
      <p class="eyebrow">Interviews &amp; talks</p>
      <RansomHeading as="h2" id="story-h" text="In Coldie’s Words" />
      <p class="story__sub">A life spent capturing depth, and trusting the technology would catch up.</p>
    </header>


    <ol class="story__index" aria-label="More interviews">
      {interviews.map((iv, i) => (
        <li class="iv">
          <YouTubeLite video={iv} title={`${iv.title} — ${iv.source}`} />
          <div class="iv__meta">
            <p class="iv__line">
              <span class="iv__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="iv__source">{iv.source}</span>
            </p>
            <h3 class="iv__title">{iv.title}</h3>
            <p class="iv__desc">{iv.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .story { padding-block: clamp(4.5rem, 10vw, 9rem); border-top: 1px solid var(--line-soft); }
  .story__head { max-width: 48ch; margin-bottom: clamp(2.5rem, 6vw, 4.5rem); }
  .story__head h2 { margin: 0; }
  .story__sub {
    font-family: var(--serif); font-size: clamp(1.05rem, 2vw, 1.5rem);
    color: var(--ink-soft); margin: 0.25em 0 0; max-width: 34ch;
  }


  /* two-column interview index */
  .story__index {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, 1fr);
    column-gap: clamp(2.5rem, 5vw, 5.5rem);
    row-gap: clamp(3.5rem, 7vw, 6rem);
  }
  .iv { margin: 0; }
  .iv__meta { margin-top: 1.4em; }
  .iv__line {
    display: flex; align-items: baseline; gap: 0.9em; margin: 0 0 0.5em;
    border-top: 1px solid var(--line-soft); padding-top: 0.9em;
  }
  .iv__num { font-family: var(--type); font-size: 0.8rem; letter-spacing: 0.08em; color: var(--red); }
  .iv__source {
    font-family: var(--type); font-size: 0.72rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink-mute);
  }
  .iv__title { font-family: var(--serif); font-size: clamp(1.35rem, 2vw, 1.75rem); line-height: 1.15; margin: 0 0 0.5em; }
  .iv__desc { margin: 0; color: var(--ink-soft); max-width: 48ch; }

  @media (max-width: 760px) {
    .story__index { grid-template-columns: 1fr; }
  }
</style>
