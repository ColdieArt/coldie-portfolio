---
// Vertical (9:16) video — plays an mp4 when `src` is set, otherwise shows a calm
// "coming soon" placeholder. For gallery/usage footage shot on phone.
export interface Props { src?: string; poster?: string; caption?: string; }
const { src = '', poster, caption } = Astro.props;
const ready = Boolean(src);
---
<figure class="vv">
  <div class="vv__frame">
    {ready ? (
      <video class="vv__video" controls playsinline preload="metadata" poster={poster}>
        <source src={src} type="video/mp4" />
      </video>
    ) : (
      <div class="vv__placeholder" role="img" aria-label="Vertical video — coming soon">
        <span class="vv__play" aria-hidden="true">▶</span>
        <span class="muted small">Vertical video — coming soon</span>
      </div>
    )}
  </div>
  {caption && <figcaption class="vv__cap muted small">{caption}</figcaption>}
</figure>

<style>
  .vv { margin: 0; max-width: 300px; }
  .vv__frame {
    aspect-ratio: 9/16; border-radius: var(--radius); overflow: hidden;
    background: var(--bg-raise); border: 1px solid var(--line);
  }
  .vv__video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vv__placeholder {
    width: 100%; height: 100%; display: grid; place-content: center;
    gap: 0.8rem; justify-items: center; text-align: center; padding: 1rem;
  }
  .vv__play {
    width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center;
    color: var(--accent); border: 1px solid var(--line); font-size: 1.1rem;
  }
  .vv__cap { margin-top: 0.8em; }
</style>
