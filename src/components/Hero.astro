---
import { site } from '../data/site';
import { heroWork } from '../data/works';
import DepthParallax from './DepthParallax.astro';
---
<section class="hero" aria-label="Introduction">
  <div class="hero__art">
    <DepthParallax layers={heroWork.layers!} ratio="16/10" amplitude={30} scroll={true} class="hero__parallax" />
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>
  <div class="wrap hero__copy">
    <h1 class="hero__title">{site.tagline}</h1>
    <p class="hero__sub lede">{site.subhead}</p>
    <p class="hero__by">Coldie · {site.location}</p>
    <div class="hero__cta">
      <a href="/studio#work" class="btn">See the work</a>
      <a href="/studio#pioneer" class="btn btn--ghost">The 2018 origin →</a>
    </div>
  </div>
  <a href="/studio#provenance" class="hero__scroll" aria-label="Scroll to provenance">
    <span aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--bg);
  }
  .hero__art { position: absolute; inset: 0; }
  .hero :global(.hero__parallax) { width: 100%; height: 100%; border-radius: 0; aspect-ratio: auto; position: absolute; inset: 0; }
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, var(--bg) 2%, color-mix(in srgb, var(--bg) 30%, transparent) 40%, transparent 75%),
      linear-gradient(to right, color-mix(in srgb, var(--bg) 65%, transparent), transparent 55%);
  }
  .hero__copy {
    position: relative;
    width: 100%;
    padding-bottom: clamp(4rem, 12vh, 9rem);
    padding-top: 8rem;
  }
  .hero__title { margin: 0 0 0.25em; }
  .hero__sub { max-width: 32ch; margin: 0 0 1em; }
  .hero__by { font-size: 0.85rem; letter-spacing: 0.06em; color: var(--ink-mute); margin: 0 0 1.6em; }
  .hero__cta { display: flex; gap: 0.9rem; flex-wrap: wrap; }

  .hero__scroll {
    position: absolute; left: 50%; bottom: 1.4rem; transform: translateX(-50%);
    width: 26px; height: 40px; border: 1px solid var(--line); border-radius: 14px;
    display: grid; place-items: start center; padding-top: 7px;
  }
  .hero__scroll span {
    width: 3px; height: 8px; border-radius: 2px; background: var(--accent);
    animation: heroScroll 1.8s ease-in-out infinite;
  }
  @keyframes heroScroll {
    0%, 100% { opacity: 0.3; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(8px); }
  }
  @media (max-width: 600px) { .hero__scroll { display: none; } }
</style>
