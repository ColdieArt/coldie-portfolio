---
// Choose-your-own-adventure opening of the homepage: one question, three doors:
// Where I've been · In the studio · Where I'm going.
// Each door leads with one artwork and lists the areas of interest on its path; links
// into the archive carry a filter (?filter= / ?series=) so the grid opens on that view.
// Hovering (or focusing) a door widens it and dims the others. A door with `slides`
// crossfades through them behind its text (one image fetched ahead at a time). The Studio sections
// follow below (#studio) for anyone who scrolls past the question.

type Link = { label: string; href: string; external?: boolean };
type Door = { key: string; title: string; line: string; img: string; alt: string; slides?: string[]; enter: Link; links: Link[] };

const doors: Door[] = [
  {
    key: 'been',
    title: 'Where I’ve been',
    line: 'LA Weekly, Coachella in 3D, then the first stereoscopic artwork on a blockchain in 2018 and every release since.',
    img: '/works/the-day/the-day.jpg',
    alt: 'The Day We’ve All Been Waiting For (2018), the first stereoscopic artwork on a blockchain',
    enter: { label: 'Experience the archive', href: '/archive?view=grid' },
    links: [
      { label: 'Formative Years', href: '/where-ive-been' },
      { label: 'First 3D on-chain, 2018', href: '/work/the-day-weve-all-been-waiting-for' },
      { label: 'Decentral Eyes', href: '/series/decentral-eyes' },
      { label: 'Proof of Work', href: '/archive?series=Proof%20of%20Work' },
      { label: 'The journey', href: '#story' },
      { label: 'Provenance', href: '#provenance' },
    ],
  },
  {
    key: 'studio',
    title: 'In the studio',
    line: 'Kinetic 3D portraits you can take apart and rebuild, and art you’re meant to touch.',
    img: '/images/studio-door/eterno-gallery-lisbon.jpg',
    alt: 'Coldie at Eterno Gallery, Lisbon, in front of a wall of Decentral Eyes prints',
    enter: { label: 'Enter the studio', href: '#studio' },
    links: [
      { label: 'Eterno Gallery', href: '#current-series' },
      { label: 'Featured digital', href: '#featured-digital' },
      { label: 'Tech Epochalypse', href: '#tech-epochalypse' },
      { label: 'En Marcha', href: '#en-marcha-interactive' },
      { label: 'Kinetic portraits', href: '#kinetic-portraits' },
      { label: 'Store', href: 'https://coldie3d.myshopify.com', external: true },
      { label: 'Available now', href: '/archive?filter=sale' },
    ],
  },
  {
    key: 'going',
    title: 'Where I’m going',
    line: 'Projects and concepts I am cooking on and you can get an early look at.',
    img: '/images/doors/jack-dorsey-magnetic-portrait.jpg',
    alt: 'Jack Dorsey Magnetic Portrait by Coldie, a rearrangeable kinetic 3D portrait',
    enter: { label: 'See where I’m going', href: '/where-im-going' },
    links: [
      { label: 'Touch the Art', href: '/where-im-going#work' },
      { label: 'Filthy Fiat', href: '/where-im-going#filthy-fiat' },
      { label: 'Kinetic 3D works', href: '/archive?series=Kinetic%203D' },
      { label: 'Commissions', href: '#acquire' },
    ],
  },
];
const ext = (l: Link) => (l.external ? { target: '_blank', rel: 'noopener' } : {});
---
<section class="cx" aria-labelledby="cx-q">
  <p class="cx__q" id="cx-q">Touch the art.</p>
  <div class="cx__doors">
    {doors.map((d) => (
      <article class="cx__door" data-door={d.key} aria-labelledby={`cx-${d.key}`}>
        <img class="cx__art" src={d.img} alt={d.alt} loading="eager" decoding="async" />
        {d.slides && (
          <img class="cx__art cx__art--next" alt="" aria-hidden="true" decoding="async" data-cx-slides={JSON.stringify(d.slides)} />
        )}
        <span class="cx__veil" aria-hidden="true"></span>
        <div class="cx__body">
          <h2 class="cx__title" id={`cx-${d.key}`}>
            <a href={d.enter.href} {...ext(d.enter)}>{d.title}</a>
          </h2>
          <p class="cx__line">{d.line}</p>
          <ul class="cx__links">
            {d.links.map((l) => (
              <li><a href={l.href} {...ext(l)}>{l.label}{l.external && <span aria-hidden="true"> ↗</span>}</a></li>
            ))}
          </ul>
          <a class="cx__enter" href={d.enter.href} {...ext(d.enter)}>{d.enter.label} <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
  </div>
  <a class="cx__more" href="#studio">Or see everything <span aria-hidden="true">↓</span></a>
</section>

<style>
  .cx {
    --cx-ink: #f3f1ec; --cx-mute: #b9b4aa;
    position: relative; display: flex; flex-direction: column;
    min-height: calc(100svh - 64px); padding: clamp(1.25rem, 3vh, 2rem) clamp(0.75rem, 2vw, 1.5rem) clamp(2.75rem, 6vh, 3.5rem);
    background: #070707; color: var(--cx-ink);
  }
  /* Oversized headline that bleeds down over the top of the doors — expressive, eye-catching. */
  .cx__q {
    position: relative; z-index: 3; pointer-events: none;
    margin: clamp(0.25rem, 1.5vh, 1rem) 0 -0.3em; text-align: center;
    font-family: var(--display); text-transform: uppercase; letter-spacing: -0.01em; line-height: 0.82;
    font-size: clamp(3.2rem, 13.5vw, 13rem); color: var(--cx-ink);
    text-shadow: 0 6px 34px rgba(0, 0, 0, 0.55), 0 2px 5px rgba(0, 0, 0, 0.55);
  }
  .cx__doors { flex: 1; display: flex; gap: clamp(6px, 0.8vw, 12px); min-height: 0; }
  .cx__door {
    position: relative; flex: 1 1 0; min-width: 0; overflow: hidden; border-radius: 2px;
    display: flex; align-items: flex-end; isolation: isolate;
    transition: flex-grow 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s;
  }
  .cx__art {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2;
    filter: saturate(0.85) brightness(0.72); transform: scale(1.02);
    transition: filter 0.6s, transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cx__door[data-door='been'] .cx__art { object-position: 50% 40%; }
  .cx__door[data-door='studio'] .cx__art { object-position: 50% 50%; }
  /* slideshow: the second layer fades in over the first, then they swap */
  .cx__art--next { opacity: 0; transition: opacity 1.4s ease, filter 0.6s, transform 1.4s cubic-bezier(0.22, 1, 0.36, 1); }
  .cx__art--next.is-in { opacity: 1; }
  .cx__veil { position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.45) 45%, rgb(0 0 0 / 0.05) 75%); }
  .cx__body { padding: clamp(1rem, 2.2vw, 1.75rem); width: 100%; max-width: 34rem; }
  .cx__title { margin: 0 0 0.5rem; font-family: var(--display); font-weight: 400; text-transform: uppercase; letter-spacing: 0.01em; line-height: 0.95; font-size: clamp(1.6rem, 2.7vw, 2.75rem); }
  .cx__title a { color: var(--cx-ink); text-decoration: none; }
  .cx__line { margin: 0 0 1rem; font-size: clamp(0.85rem, 0.95vw, 1rem); line-height: 1.5; color: var(--cx-mute); max-width: 32ch; min-height: 4.5em; }
  .cx__links { list-style: none; margin: 0 0 1.1rem; padding: 0; display: flex; flex-wrap: wrap; align-content: flex-start; gap: 6px; min-height: 6.6rem; }
  .cx__links a {
    display: inline-block; padding: 0.38rem 0.75rem; border-radius: 999px; font-size: 0.74rem; font-weight: 500;
    color: var(--cx-ink); text-decoration: none; border: 1px solid rgb(255 255 255 / 0.28); background: rgb(0 0 0 / 0.35);
    backdrop-filter: blur(6px); transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .cx__links a:hover, .cx__links a:focus-visible { background: var(--cx-ink); color: #0a0a0a; border-color: var(--cx-ink); }
  .cx__enter {
    display: inline-flex; gap: 0.5rem; align-items: center; padding: 0.75rem 1.15rem; border-radius: 999px;
    background: var(--cx-ink); color: #0a0a0a; text-decoration: none; font-size: 0.82rem; font-weight: 700;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s;
  }
  .cx__enter:hover, .cx__enter:focus-visible { transform: translateY(-2px); box-shadow: -4px 0 0 #ff3d3d, 4px 0 0 #45c7d0; }
  .cx__more { position: absolute; left: 50%; bottom: 0.8rem; transform: translateX(-50%); font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cx-mute); text-decoration: none; }
  .cx__more:hover { color: var(--cx-ink); }

  /* the door you're looking at opens up; the others step back */
  @media (hover: hover) and (min-width: 901px) {
    .cx__doors:hover .cx__door, .cx__doors:focus-within .cx__door { opacity: 0.55; }
    .cx__doors .cx__door:is(:hover, :focus-within) { flex-grow: 1.7; opacity: 1; }
    .cx__door:is(:hover, :focus-within) .cx__art { filter: saturate(1) brightness(0.92); transform: scale(1.06); }
  }

  @media (max-width: 900px) {
    .cx { min-height: 0; }
    .cx__doors { flex-direction: column; }
    .cx__door { min-height: 46svh; }
    .cx__veil { background: linear-gradient(to top, rgb(0 0 0 / 0.92) 0%, rgb(0 0 0 / 0.6) 55%, rgb(0 0 0 / 0.15) 85%); }
    .cx__line, .cx__links { min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cx__door, .cx__art, .cx__enter { transition: none; }
  }
</style>

<script>
  // Crossfade a door's slides: preload the next image into the hidden layer, fade it
  // in, then copy it to the base layer and reset. Pauses off-screen / reduced motion.
  document.querySelectorAll<HTMLImageElement>('[data-cx-slides]').forEach((next) => {
    const base = next.previousElementSibling as HTMLImageElement;
    const slides: string[] = JSON.parse(next.dataset.cxSlides || '[]');
    if (slides.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let i = 0, timer = 0, visible = true;
    const advance = () => {
      if (!visible || document.hidden) return;
      const k = (i + 1) % slides.length;
      const pre = new Image();
      pre.onload = () => {
        next.src = slides[k];
        requestAnimationFrame(() => next.classList.add('is-in'));
        window.setTimeout(() => {
          base.src = slides[k];
          next.classList.remove('is-in');
          i = k;
        }, 1500);
      };
      pre.src = slides[k];
    };
    const start = () => { if (!timer) timer = window.setInterval(advance, 4200); };
    const stop = () => { clearInterval(timer); timer = 0; };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : stop(); }).observe(base);
  });
</script>
