---
// RansomHeading — avant-garde "ransom note" collage headline. Each letter is a
// greyscale paper cut-out with its own font (serif/sans/slab/typewriter mix),
// a rotation on all three axes (x/y/z), a Z-plane, and ~30% size variation.
// On scroll the letters parallax by depth and gently rock/settle as if the whole
// word is balancing. Per-letter styling is deterministic at build time (stable,
// no layout shift, works without JS).
export interface Props {
  text?: string;
  lines?: string[];
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
  class?: string;
  seed?: string;
  parallax?: boolean;
  size?: string; /* optional CSS font-size override for the whole collage */
}
const { text, lines, as = 'h2', id, class: klass = '', seed, parallax = true, size } = Astro.props;
const Tag = as;
const srcLines = (lines && lines.length ? lines : (text ?? '').split('\n')).filter((l) => l.length > 0);
const fullText = srcLines.join(' ');

// Deterministic PRNG so the collage is stable across builds/renders.
function hashStr(s: string): number {
  let h = 2166136261 >>> 0;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
  return h >>> 0;
}
function mulberry32(a: number) {
  return function () {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rnd = mulberry32(hashStr((seed ?? fullText) + '::coldie-ransom-v2'));
const pick = <T,>(arr: T[]): T => arr[Math.floor(rnd() * arr.length)];

const FONTS = [
  "'Anton',sans-serif",
  "'Archivo Black',sans-serif",
  "'Oswald',sans-serif",
  "'DM Serif Display',serif",
  "'Playfair Display',serif",
  "'Special Elite',monospace",
  "'Rye',serif",
];
// Greyscale paper swatches only — newsprint black / white / greys.
// `dot` = halftone dot colour tuned to the paper's lightness.
const PAPERS = [
  { bg: '#f2f2f0', inks: ['#141414', '#3b3b3a'], dot: 'rgba(18,18,18,0.5)' },
  { bg: '#f2f2f0', inks: ['#141414'], dot: 'rgba(18,18,18,0.5)' },
  { bg: '#e3e3e1', inks: ['#141414'], dot: 'rgba(18,18,18,0.46)' },
  { bg: '#cfcfcc', inks: ['#141414'], dot: 'rgba(18,18,18,0.42)' },
  { bg: '#a9a9a6', inks: ['#141414', '#f2f2f0'], dot: 'rgba(18,18,18,0.4)' },
  { bg: '#2b2b2a', inks: ['#f2f2f0'], dot: 'rgba(242,242,240,0.3)' },
  { bg: '#151515', inks: ['#f2f2f0', '#cfcfcc'], dot: 'rgba(242,242,240,0.26)' },
  { bg: '#151515', inks: ['#f2f2f0'], dot: 'rgba(242,242,240,0.26)' },
];
// Scissor/torn cuts — subtle irregular quads; some left clean.
const CUTS = [
  'polygon(2% 5%,98% 1%,100% 95%,1% 99%)',
  'polygon(0% 7%,97% 2%,100% 93%,3% 98%)',
  'polygon(3% 1%,100% 6%,98% 100%,0% 94%)',
  'polygon(1% 2%,99% 0%,99% 98%,2% 100%)',
  'none',
  'none',
];
const DEPTHS = [0.25, 0.5, 0.75, 1.0];

function spec() {
  const font = pick(FONTS);
  const paper = pick(PAPERS);
  const ink = pick(paper.inks);
  const rot = +(rnd() * 12 - 6).toFixed(1);       // z base
  const rx = (rnd() * 56 - 28).toFixed(1);        // x pivot — strong, so it reads 3D
  const ry = (rnd() * 64 - 32).toFixed(1);        // y pivot — strong
  const oy = (rnd() * 0.12 - 0.06).toFixed(3);
  const depth = pick(DEPTHS);
  const z = ((depth - 0.5) * 32).toFixed(1);
  const fs = (0.78 + rnd() * 0.5).toFixed(3);     // ~60% size variation (0.78–1.28)
  const ml = (-(0.03 + rnd() * 0.12)).toFixed(3); // overlap previous letter up to ~15%
  const cut = pick(CUTS);
  const px = (0.06 + rnd() * 0.06).toFixed(3);
  const py = (0.0 + rnd() * 0.05).toFixed(3);
  const halftone = rnd() < 0.4;                   // ~40% of letters get a dot screen
  const hts = (4 + rnd() * 3).toFixed(1);         // halftone cell 4–7px
  const style =
    `font-family:${font};--bg:${paper.bg};color:${ink};` +
    `--rot:${rot}deg;--rz:${rot}deg;--rx:${rx}deg;--ry:${ry}deg;` +
    `--oy:${oy}em;--z:${z}px;--fs:${fs};--ml:${ml}em;--cut:${cut};--px2:${px}em;--py2:${py}em;` +
    `--htc:${paper.dot};--hts:${hts}px;`;
  return { style, depth, rot, halftone };
}

const model = srcLines.map((line) =>
  line.split(' ').map((word) => Array.from(word).map((ch) => ({ ch, ...spec() })))
);
---
<Tag id={id} class={`ransom ${klass}`.trim()} aria-label={fullText} data-ransom={parallax ? '' : undefined} style={size ? `font-size:${size}` : undefined}>
  <span class="ransom__inner" aria-hidden="true">
    {model.map((line) => (
      <span class="ransom__line">
        {line.map((word, wi) => (
          <>
            {wi > 0 && <span class="ransom__space"> </span>}
            <span class="ransom__word">
              {word.map((c) => (
                <span class="ransom__char" style={c.style} data-depth={c.depth} data-rot={c.rot} data-ht={c.halftone ? '' : undefined}>{c.ch}</span>
              ))}
            </span>
          </>
        ))}
      </span>
    ))}
  </span>
</Tag>

<style>
  .ransom {
    text-transform: uppercase;
    line-height: 0.9;
    letter-spacing: 0;
    perspective: 620px;
    font-size: clamp(2.6rem, 6.4vw, 5.4rem);
    margin: 0 0 0.45em;
  }
  .ransom__inner { display: inline-block; transform-style: preserve-3d; }
  .ransom__line { display: block; }
  .ransom__word { display: inline-block; white-space: nowrap; }
  .ransom__space { display: inline-block; width: 0.32em; }
  .ransom__char {
    display: inline-block;
    font-size: calc(1em * var(--fs, 1));
    background: var(--bg, #f2f2f0);
    padding: var(--py2, 0.02em) var(--px2, 0.09em);
    margin: 0.02em 0 0.02em var(--ml, -0.06em);
    border-radius: 1px;
    clip-path: var(--cut, none);
    filter: drop-shadow(1px 2px 0 rgba(0, 0, 0, 0.42));
    transform:
      translateY(var(--oy, 0))
      translate3d(0, var(--py, 0px), var(--z, 0px))
      rotateX(var(--rx, 0deg))
      rotateY(var(--ry, 0deg))
      rotateZ(var(--rz, 0deg));
    transform-style: preserve-3d;
    backface-visibility: hidden;
    will-change: transform;
  }
  /* Halftone dot screen on ~40% of letters — dots sit on the paper, behind the
     glyph, so the letter stays legible but reads like newsprint photo halftone. */
  .ransom__char[data-ht] {
    background-image: radial-gradient(circle, var(--htc, rgba(18,18,18,0.45)) 0.85px, transparent 1.5px);
    background-size: var(--hts, 5px) var(--hts, 5px);
    background-position: center;
    background-repeat: repeat;
  }
  /* Long words can't break mid-word, so shrink the collage on small screens
     to keep the longest word inside the viewport. */
  @media (max-width: 620px) {
    .ransom { font-size: clamp(1.55rem, 8vw, 2.9rem); }
    .ransom__char {
      margin: 0.035em 0.004em;
      padding: calc(var(--py2, 0.02em) * 0.7) calc(var(--px2, 0.09em) * 0.55);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ransom__char {
      transform:
        translateY(var(--oy, 0))
        rotateX(var(--rx, 0deg))
        rotateY(var(--ry, 0deg))
        rotateZ(var(--rot, 0deg));
    }
  }
</style>

<script>
  // Scroll behaviour: letters parallax by depth plane, and the whole word gently
  // rocks and settles as if balancing — rock scales with scroll velocity, decays
  // back to rest. rAF-driven; only runs for headings in view; off for reduced-motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    type Ch = { el: HTMLElement; d: number; rot: number };
    type Head = { el: HTMLElement; chars: Ch[] };
    const heads: Head[] = Array.from(document.querySelectorAll<HTMLElement>('[data-ransom]')).map((el) => ({
      el,
      chars: Array.from(el.querySelectorAll<HTMLElement>('.ransom__char')).map((c) => ({
        el: c,
        d: parseFloat(c.getAttribute('data-depth') || '0.5'),
        rot: parseFloat(c.getAttribute('data-rot') || '0'),
      })),
    }));
    if (heads.length) {
      const active = new Set<Head>();
      const byEl = new Map(heads.map((h) => [h.el, h]));
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const h = byEl.get(e.target as HTMLElement);
            if (!h) continue;
            if (e.isIntersecting) active.add(h); else active.delete(h);
          }
          if (active.size) kick();
        },
        { rootMargin: '25% 0px 25% 0px' }
      );
      heads.forEach((h) => io.observe(h.el));

      const AMP = 38;        // parallax travel (px) at full depth
      const ROCK_MAX = 9;    // max balancing rock (deg) at full depth
      let swayTarget = 0;    // driven by scroll velocity, decays to 0
      let sway = 0;          // eased actual rock
      let lastY = window.scrollY;
      let running = false;
      let lastT = 0;

      function apply() {
        const vh = window.innerHeight;
        active.forEach((h) => {
          const r = h.el.getBoundingClientRect();
          const rel = (r.top + r.height / 2 - vh / 2) / vh;
          for (const c of h.chars) {
            c.el.style.setProperty('--py', (-rel * c.d * AMP).toFixed(1) + 'px');
            c.el.style.setProperty('--rz', (c.rot + sway * c.d).toFixed(2) + 'deg');
          }
        });
      }
      function loop(now: number) {
        const dt = Math.min(2.2, (now - lastT) / 16.67 || 1);
        lastT = now;
        swayTarget *= Math.pow(0.86, dt);                 // target settles toward 0
        sway += (swayTarget - sway) * (1 - Math.pow(0.8, dt)); // ease toward target
        apply();
        if (Math.abs(sway) > 0.02 || Math.abs(swayTarget) > 0.02) {
          requestAnimationFrame(loop);
        } else {
          running = false; sway = 0; swayTarget = 0; apply(); // settle flat
        }
      }
      function kick() {
        if (!running) { running = true; lastT = performance.now(); requestAnimationFrame(loop); }
      }
      function onScroll() {
        const y = window.scrollY;
        const v = y - lastY; lastY = y;
        swayTarget = Math.max(-ROCK_MAX, Math.min(ROCK_MAX, swayTarget + v * 0.22));
        if (active.size) kick();
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => { if (active.size) kick(); });
      apply(); // set initial parallax offsets
    }
  }
</script>
