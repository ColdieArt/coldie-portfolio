---
import { site } from '../data/site';

const links: { label: string; href: string; external?: boolean }[] = [
  { label: 'Digital', href: '/#featured-digital' },
  { label: 'Physical', href: '/#current-series' },
  { label: 'Filthy Fiat', href: '/#filthy-fiat' },
  { label: 'Touch the Art', href: '/#work' },
  { label: 'Stereo 3D', href: '/#pioneer' },
  { label: 'Archive', href: '/archive' },
  { label: 'Story', href: '/#story' },
  { label: 'Store', href: 'https://coldie3d.myshopify.com', external: true },
];
---

<header class="nav" data-nav>
  <div class="wrap nav__row">
    <a class="nav__brand" href="/" aria-label={`${site.name} — home`}>
      <img class="nav__logo" src="/logo/coldie-sticker.webp" alt="Coldie" width="640" height="481" />
    </a>

    <button
      class="nav__toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-menu"
      data-nav-toggle
    >
      <svg class="nav__ico nav__ico--open" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
      </svg>
      <svg class="nav__ico nav__ico--close" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
        <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" />
      </svg>
    </button>

    <nav id="nav-menu" class="nav__links" aria-label="Primary" data-nav-menu>
      {links.map((l) => (
        <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>
      ))}
      <a href="/#acquire" class="btn btn--solid nav__cta">Inquire</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: saturate(140%) blur(10px);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, background 0.3s;
  }
  .nav[data-scrolled] {
    border-bottom-color: var(--line-soft);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
  }
  .nav__row {
    display: flex;
    align-items: center;
    justify-content: flex-end; /* links/CTA sit right; the logo is positioned */
    min-height: 64px;          /* nav keeps its original height */
    position: relative;
  }
  /* Logo is pulled out of the flow so it can hang over the bar and bleed off the
     top edge without making the nav taller. */
  .nav__brand {
    position: absolute;
    left: var(--gutter);       /* align with the content gutter */
    top: -14px;                /* slightly off the top of the screen */
    z-index: 3;
    line-height: 0;
    text-decoration: none;
  }
  .nav__logo { height: 124px; width: auto; display: block; background: transparent; }

  .nav__links { display: flex; align-items: center; gap: clamp(1rem, 2.5vw, 2rem); }
  .nav__links > a:not(.btn) {
    font-family: var(--type);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .nav__links > a:not(.btn):hover { color: var(--ink); }
  .nav__cta { padding: 0.5em 1em; }

  /* hamburger toggle — hidden on desktop */
  .nav__toggle {
    display: none;
    position: relative;
    z-index: 4;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }
  .nav__ico { display: block; }
  .nav__ico--close { display: none; }
  .nav[data-menu-open] .nav__ico--open { display: none; }
  .nav[data-menu-open] .nav__ico--close { display: block; }

  /* ---- mobile: collapse the links into a top-right dropdown ---- */
  @media (max-width: 920px) {
    .nav__logo { height: 92px; }
    .nav__brand { top: -8px; }
    .nav__toggle { display: inline-flex; }
    .nav__links {
      position: absolute;
      top: calc(100% + 2px);
      right: var(--gutter);
      flex-direction: column;
      align-items: flex-end;
      gap: 1rem;
      min-width: 220px;
      padding: 1.2rem 1.4rem;
      background: color-mix(in srgb, var(--bg) 97%, transparent);
      backdrop-filter: saturate(140%) blur(10px);
      border: 1px solid var(--line-soft);
      border-radius: var(--radius);
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.45);
      display: none;
    }
    .nav[data-menu-open] .nav__links { display: flex; }
    .nav__links > a:not(.btn) { font-size: 0.95rem; }
    .nav__cta { margin-top: 0.3rem; }
  }
</style>

<script>
  const nav = document.querySelector('[data-nav]');
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.querySelector('[data-nav-menu]');

  // Hairline once scrolled past the hero lip.
  const onScroll = () => {
    if (window.scrollY > 24) nav?.setAttribute('data-scrolled', '');
    else nav?.removeAttribute('data-scrolled');
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile dropdown menu.
  function setOpen(open: boolean) {
    if (!nav || !toggle) return;
    nav.toggleAttribute('data-menu-open', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }
  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(!nav?.hasAttribute('data-menu-open'));
  });
  // Close after choosing a destination.
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  // Close on outside click or Escape.
  document.addEventListener('click', (e) => {
    if (nav?.hasAttribute('data-menu-open') && !(e.target as HTMLElement).closest('.nav__row')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
