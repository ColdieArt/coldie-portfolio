---
// Placeholder shown where the artist's own copy goes, until it's written.
// Describes the slot so the page doubles as a writing brief.
interface Props {
  label: string;
  length: string;
  guidance: string;
  example?: string;
  field: string;
}
const { label, length, guidance, example, field } = Astro.props;
---
<div class="slot" role="note">
  <p class="slot__head"><span class="slot__label">Your copy · {label}</span><span class="slot__len">{length}</span></p>
  <p class="slot__guide">{guidance}</p>
  {example && <p class="slot__example"><span>Example</span>{example}</p>}
  <p class="slot__field"><code>{field}</code></p>
</div>

<style>
  .slot {
    border: 1px dashed var(--ink-mute); padding: 1rem 1.1rem; margin: 0.25rem 0 1rem;
    background: repeating-linear-gradient(135deg, transparent 0 10px, rgb(236 234 227 / 0.018) 10px 20px);
  }
  .slot__head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; margin: 0 0 0.5rem; }
  .slot__label, .slot__len {
    font-family: var(--sans); font-size: 0.6rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .slot__label { color: var(--gold); }
  .slot__len { color: var(--ink-mute); }
  .slot__guide { margin: 0; font-size: 0.9rem; line-height: 1.55; color: var(--ink-soft); }
  .slot__example { margin: 0.6rem 0 0; font-family: var(--serif); font-style: italic; font-size: 0.92rem; color: var(--ink-mute); }
  .slot__example span {
    display: block; font-family: var(--sans); font-style: normal; font-size: 0.56rem; letter-spacing: 0.16em;
    text-transform: uppercase; margin-bottom: 0.2rem;
  }
  .slot__field { margin: 0.6rem 0 0; }
  .slot__field code { font-size: 0.68rem; color: var(--ink-mute); }
</style>
