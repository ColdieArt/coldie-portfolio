---
// En Marcha — interactive kinetic 3D mural (Digital Encounters). Click-to-start, the
// same pattern as the Available works page: the still poster shows with a play button;
// the live artwork preloads quietly after the page loads and reveals on click. The IPFS
// gateway serves the HTML with no framing restriction, so it embeds directly.
import RansomHeading from './RansomHeading.astro';
const ART = 'https://ipfs2.seadn.io/ipfs/bafybeihz2miflux2g7uobrgobrqnzz74cllitoew57njalwqraudriqpra/media';
const TRANSIENT = 'https://www.transient.xyz/nfts/ethereum/0x034220c41322ff03db1c643da2ce991440a29bdd/2';
---
<section id="en-marcha-interactive" class="enm section--flat" aria-labelledby="enm-h">
  <div class="wrap">
    <header class="enm__head">
      <p class="eyebrow">Interactive · Digital Encounters</p>
      <RansomHeading as="h2" id="enm-h" text="En Marcha" />
      <p class="lede enm__lede">
        A kinetic 3D mural inspired by Diego Rivera and Museo Anahuacalli, built during the
        <a href="https://8nap.art/" target="_blank" rel="noopener">8NAP Art</a> ‘Digital Encounters’
        residency. Every element was photographed in Rivera’s collection, then hand-embellished — touch the
        art, move the pieces, and step inside the collage.
      </p>
      <p class="enm__edition">2026, Edition of 5 Kinetic 3D Collage tokens</p>
    </header>

    <figure class="enm__stage">
      <div class="enm__player" data-enm-frame>
        <iframe
          class="enm__iframe"
          data-src={ART}
          title="En Marcha — interactive kinetic 3D mural by Coldie"
          allow="accelerometer; gyroscope; fullscreen"
          allowfullscreen
          tabindex="-1"
          data-enm-live
        ></iframe>
        <!-- poster shows until the visitor starts the live mural -->
        <img class="enm__poster" src="/works/digital/en-marcha.webp" alt="En Marcha — interactive kinetic 3D mural by Coldie" loading="lazy" decoding="async" />
        <button type="button" class="enm__start" data-enm-start aria-label="Start En Marcha, interactive artwork">
          <span class="enm__play" aria-hidden="true">▶</span>
          <span class="enm__label" data-enm-label>Click to start · touch the art</span>
        </button>
      </div>
      <figcaption class="enm__cap">
        En Marcha #2 — Digital Encounters.
        <a href={TRANSIENT} target="_blank" rel="noopener">Collect on Transient ↗</a>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .enm { padding-block: clamp(3rem, 7vw, 6rem); border-top: 1px solid var(--line-soft); }
  .enm__head { max-width: 62ch; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .enm__head h2 { margin: 0 0 0.4em; }
  .enm__lede { margin: 0; }
  .enm__edition {
    margin: 1em 0 0;
    font-family: var(--type); font-size: 0.8rem; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--ink-soft);
  }

  .enm__stage { margin: 0; }
  .enm__player {
    position: relative;
    aspect-ratio: 16 / 10;
    max-height: 80vh;
    border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; background: var(--bg-raise);
    box-shadow: 6px 6px 0 color-mix(in srgb, var(--cyan) 24%, transparent);
  }
  .enm__poster {
    position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1;
    object-fit: cover; display: block; transition: opacity 0.5s;
  }
  .enm__iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; opacity: 0; pointer-events: none; }
  /* Click-to-start overlay — matches the Available works page. */
  .enm__start {
    position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; align-content: center; gap: 0.9rem;
    padding: 0; border: 0; cursor: pointer; color: #fff; font: inherit;
    background: linear-gradient(to top, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.1) 55%);
    transition: opacity 0.5s;
  }
  .enm__play {
    width: 78px; height: 78px; border-radius: 50%; display: grid; place-items: center; padding-left: 4px;
    background: #f3f1ec; color: #141414; font-size: 1.6rem; box-shadow: 0 6px 24px rgb(0 0 0 / 0.45);
    transition: transform 0.25s ease;
  }
  .enm__start:is(:hover, :focus-visible) .enm__play { transform: scale(1.08); }
  .enm__label { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; text-shadow: 0 1px 6px rgb(0 0 0 / 0.6); }
  .enm__player[data-live] .enm__iframe { opacity: 1; pointer-events: auto; z-index: 3; }
  .enm__player[data-live] .enm__poster, .enm__player[data-live] .enm__start { opacity: 0; pointer-events: none; }
  .enm__player[data-live] { box-shadow: 6px 6px 0 color-mix(in srgb, var(--red) 26%, transparent); }
  .enm__cap {
    margin: 0.9em 0 0; font-family: var(--type); font-size: 0.8rem;
    letter-spacing: 0.04em; color: var(--ink-mute);
  }
  .enm__cap a { color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid var(--line); }
  .enm__cap a:hover { color: var(--red); }

  @media (max-width: 640px) { .enm__player { aspect-ratio: 4 / 3; } }
  @media (prefers-reduced-motion: reduce) { .enm__poster, .enm__play { transition: none; } }
</style>


<script>
  // Click-to-start, matching the Available works page: preload the live artwork quietly
  // once the page has loaded so it's ready by the time someone clicks; clicking before
  // it's ready shows a loading label and reveals it the moment it finishes.
  document.querySelectorAll<HTMLIFrameElement>('iframe[data-enm-live]').forEach((frame) => {
    const box = frame.closest<HTMLElement>('.enm__player');
    const start = box?.querySelector<HTMLButtonElement>('[data-enm-start]');
    const label = box?.querySelector<HTMLElement>('[data-enm-label]');
    if (!box || !start) return;
    let ready = false, wanted = false;
    const reveal = () => { box.setAttribute('data-live', ''); frame.tabIndex = 0; frame.focus({ preventScroll: true }); };
    frame.addEventListener('load', () => { if (!frame.src) return; ready = true; if (wanted) reveal(); });
    const load = () => { if (!frame.src) frame.src = frame.dataset.src ?? ''; };
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 2000 }) : setTimeout(load, 300));
    if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
    start.addEventListener('click', () => {
      wanted = true;
      load();
      if (ready) reveal();
      else if (label) label.textContent = 'Loading…';
    });
  });
</script>
