---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { personLd, breadcrumbLd } from '../data/jsonld';

// ── Knowledge / FAQ hub ───────────────────────────────────────────────
// A fact-dense, answer-first page written to be *cited* by search engines and AI
// answer tools. Every answer is grounded in the facts already on the site (bio,
// the auction arc, Decentral Eyes, Front Row 3D) — nothing is invented. The Q&A
// is mirrored into FAQPage structured data so the same text can surface as a rich
// result, a "People also ask" answer, or an AI citation.

const PATH = '/faq';

// Shared slug so glossary anchors (#term-…) match the links other pages point at.
const termSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// Answers are plain text so the visible page and the schema match exactly.
const faqs: { q: string; a: string }[] = [
  {
    q: 'Who is Coldie?',
    a: 'Coldie is a stereoscopic-3D and kinetic artist based in Sacramento, California. On May 7, 2018 he minted “The Day We’ve All Been Waiting For,” the first stereoscopic artwork recorded on a blockchain, and has since created more than 180 on-chain works — most notably the Decentral Eyes portrait series. His work has been brought to auction at all three major houses: Christie’s, Sotheby’s and Bonhams.',
  },
  {
    q: 'What was the first stereoscopic 3D artwork minted on a blockchain?',
    a: '“The Day We’ve All Been Waiting For,” minted by Coldie on R.A.R.E. Art Labs on May 7, 2018. It is recognized as the first stereoscopic (3D) artwork recorded on-chain, and it opens Coldie’s on-chain archive.',
  },
  {
    q: 'What is stereoscopic 3D art?',
    a: 'Stereoscopic art presents two slightly offset images — one for each eye — so the brain fuses them into a single picture with real depth. Coldie builds that depth with anaglyph 3D (viewed through red/blue glasses), lenticular prints, parallax animation, and VR/AR, giving a flat image genuine dimension.',
  },
  {
    q: 'What is the Decentral Eyes series?',
    a: 'Decentral Eyes is Coldie’s stereoscopic 3D portrait series, begun in 2018, featuring important figures of the blockchain and tech movement — including Vitalik Buterin, Satoshi Nakamoto, Edward Snowden, Warren Buffett and Snoop Dogg. Each portrait is a “decentralized” collage of 10 or more source images, rendered with 3D glasses, parallax animation, VR/AR and kinetic techniques.',
  },
  {
    q: 'How do you see the 3D effect in Coldie’s work?',
    a: 'It depends on the piece. Anaglyph works are viewed through red/cyan (blue/red) 3D glasses; lenticular prints shift as you move around them; parallax-animated and VR/AR works render depth on screen without glasses. Many Decentral Eyes portraits are made to be seen through 3D glasses.',
  },
  {
    q: 'Which auction houses have shown Coldie’s work?',
    a: 'All three major houses, and each time the house chose the 3D work. Christie’s offered “Warren Buffett — Filthy Fiat” in 2024; Sotheby’s included his stereoscopic art in the 2022 live single-owner NFT auction “Inside the World of MaxStealth,” alongside Beeple, XCOPY and Pak; and Bonhams featured “Proof of Work — Genesis” in its 2021 SuperRare “CryptOGs” sale.',
  },
  {
    q: 'What is crypto art, and why does Coldie make it?',
    a: 'Crypto art is artwork minted and owned on a blockchain, which gives it verifiable authenticity and a permanent, public record of ownership. Coldie learned about Bitcoin and decentralization in 2017 and began making blockchain-themed work to help document and spread the movement — treating the blockchain as a provenance feature, not a gimmick.',
  },
  {
    q: 'What is Front Row 3D?',
    a: 'Front Row 3D is Coldie’s archive of live-music photography shot in stereoscopic 3D with a camera of his own construction. He was the official 3D photographer of the Coachella Festival in 2009 and 2010, capturing performers including Chris Cornell, Mac Miller and DMX, and the series was exhibited as Front Row 3D at Gazelli Art House, London.',
  },
  {
    q: 'What is kinetic 3D collage, or “Touch the Art”?',
    a: 'Kinetic 3D collage is Coldie’s physical, hand-arranged 3D portraiture that the viewer can rearrange — magnetic pieces on a dimensional surface, guided by the mantra “touch the art.” The first kinetic portrait sold at Christie’s; current kinetic work is on view and available at Eterno Gallery, Lisbon.',
  },
  {
    q: 'What mediums does Coldie work in?',
    a: 'Anaglyph 3D, lenticular prints, parallax animation, VR/AR, kinetic 3D collage, archival prints, and on-chain digital editions. The through-line across every medium is depth: taking something flat and giving it dimension.',
  },
  {
    q: 'Where can you collect Coldie’s work?',
    a: 'On-chain 1/1s and editions are on SuperRare, OpenSea and Transient; physical kinetic 3D works are shown and available at Eterno Gallery, Lisbon; and prints are available in the Coldie store. The complete record of every release, collector and sale is public in the archive.',
  },
  {
    q: 'Where is Coldie based?',
    a: 'Sacramento, California.',
  },
];

// Glossary of the stereoscopic / 3D vocabulary used across the work. Short, accurate
// definitions double as a DefinedTermSet so each term can be cited on its own.
const glossary: { term: string; def: string }[] = [
  {
    term: 'Stereoscopy',
    def: 'The technique of creating the illusion of depth by presenting two slightly different images — one to each eye. First demonstrated in the 1830s, it is the basis of all 3D photography and film; Coldie calls it “a 170-year-old way of seeing.”',
  },
  {
    term: 'Stereoscopic pair',
    def: 'The two source images — a left-eye view and a right-eye view — that a stereoscopic artwork is built from. When the brain fuses them, the scene reads in real depth.',
  },
  {
    term: 'Anaglyph 3D',
    def: 'A stereoscopic method that encodes the left- and right-eye images in two colors (typically red and cyan) so matching red/blue 3D glasses separate them. Many Decentral Eyes portraits are anaglyphs, shown with 3D glasses.',
  },
  {
    term: 'Lenticular',
    def: 'A print technique that lays an array of tiny lenses over interlaced images, so the picture shifts, animates, or shows depth as you move around it — no glasses required.',
  },
  {
    term: 'Parallax',
    def: 'The apparent shift of nearer and farther objects as the viewpoint moves. Layering elements and animating that shift lets Coldie build depth on a screen without glasses.',
  },
  {
    term: 'Wigglegram',
    def: 'An animated image that rapidly alternates between the left- and right-eye views, producing a “wiggle” that reads as 3D without glasses. Coldie has released wigglegram editions.',
  },
  {
    term: 'Binocular disparity',
    def: 'The small difference between what the left and right eyes see, caused by their separation. The brain reads this disparity as depth — the perceptual basis of all stereoscopy.',
  },
  {
    term: 'Convergence',
    def: 'The inward angling of the eyes to fix on a single point. Stereoscopic images are composed so the eyes converge naturally, placing elements in front of or behind the picture plane.',
  },
  {
    term: 'Autostereoscopy (glasses-free 3D)',
    def: 'Any method that delivers a 3D effect without special eyewear — lenticular prints, parallax animation, wigglegrams, or holographic displays.',
  },
  {
    term: 'Volumetric',
    def: 'Describing art or capture that represents true three-dimensional volume — depth in every direction — rather than a flat image with simulated depth.',
  },
  {
    term: 'Interaxial distance',
    def: 'The distance between the two lenses (or eyes) capturing a stereo pair. A wider interaxial exaggerates the depth effect; a narrower one flattens it.',
  },
  {
    term: 'Picture plane',
    def: 'The flat surface of the artwork itself. Stereoscopic work places elements in front of it (“popping out”) or behind it (“into the window”).',
  },
  {
    term: 'Kinetic 3D collage',
    def: 'Coldie’s physical, rearrangeable 3D portraiture: magnetic cut-out pieces mounted at different depths that the viewer can move and re-compose — “touch the art.”',
  },
  {
    term: 'Gel transfer',
    def: 'A hand process that lifts a printed image into a thin, flexible film which is then layered onto a surface. Coldie uses it — often on burnt canvas — in his stereoscopic fine-art works.',
  },
];

const description =
  'Answers about Coldie, the stereoscopic-3D and kinetic artist who minted the first 3D artwork on a blockchain in 2018 — the Decentral Eyes series, auctions at Christie’s, Sotheby’s and Bonhams, Front Row 3D, where to collect — plus a glossary of 3D terms: anaglyph, lenticular, parallax, wigglegram and more.';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${site.url}${PATH}#faq`,
  url: `${site.url}${PATH}`,
  name: 'Coldie — Frequently Asked Questions',
  about: { '@id': `${site.url}/#person` },
  inLanguage: 'en',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const glossaryLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': `${site.url}${PATH}#glossary`,
  name: 'Glossary of stereoscopic 3D art terms',
  description: 'Definitions of the stereoscopic and 3D vocabulary used across Coldie’s work.',
  about: { '@id': `${site.url}/#person` },
  inLanguage: 'en',
  hasDefinedTerm: glossary.map((g) => ({
    '@type': 'DefinedTerm',
    '@id': `${site.url}${PATH}#term-${termSlug(g.term)}`,
    name: g.term,
    description: g.def,
    url: `${site.url}${PATH}#term-${termSlug(g.term)}`,
    inDefinedTermSet: { '@id': `${site.url}${PATH}#glossary` },
  })),
};

// Deep links that let search and AI tools (and people) follow the facts to their source.
const explore = [
  { label: 'Decentral Eyes — the 3D portrait series', href: '/series/decentral-eyes' },
  { label: 'About Coldie', href: '/about' },
  { label: 'The complete on-chain archive', href: '/archive' },
  { label: 'The first 3D artwork on a blockchain (2018)', href: '/work/the-day-weve-all-been-waiting-for' },
  { label: 'Where I’ve been — the formative years', href: '/where-ive-been' },
];
---
<BaseLayout
  title="Coldie FAQ — Stereoscopic 3D & Crypto Art, Answered"
  description={description}
  path={PATH}
  jsonld={[personLd(), faqLd, glossaryLd, breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'FAQ', path: PATH }])]}
>
  <article class="faqp">
    <div class="wrap faqp__wrap">
      <nav class="faqp__crumb small muted" aria-label="Breadcrumb">
        <a href="/">Home</a> · <span>FAQ</span>
      </nav>

      <header class="faqp__head">
        <p class="eyebrow">Questions &amp; answers</p>
        <h1 class="faqp__h1">Coldie — frequently asked questions</h1>
        <p class="lede faqp__lede">{description}</p>
      </header>

      <dl class="faqp__list">
        {faqs.map((f) => (
          <div class="faqp__item">
            <dt class="faqp__q">{f.q}</dt>
            <dd class="faqp__a">{f.a}</dd>
          </div>
        ))}
      </dl>

      <section class="faqp__glossary" id="glossary" aria-labelledby="glossary-h">
        <h2 class="faqp__gloss-h" id="glossary-h">Glossary of 3D terms</h2>
        <p class="faqp__gloss-intro muted">The stereoscopic and 3D vocabulary behind the work — from anaglyph and lenticular to wigglegrams and parallax.</p>
        <dl class="faqp__gloss-list">
          {glossary.map((g) => (
            <div class="faqp__gloss-item" id={`term-${termSlug(g.term)}`}>
              <dt class="faqp__term">{g.term}</dt>
              <dd class="faqp__def">{g.def}</dd>
            </div>
          ))}
        </dl>
      </section>

      <nav class="faqp__explore" aria-label="Explore the work">
        <h2 class="faqp__explore-h">Follow the work</h2>
        <ul>
          {explore.map((e) => (
            <li><a class="link-arrow" href={e.href}>{e.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .faqp { padding-block: clamp(2.5rem, 6vw, 4.5rem) var(--section-y); }
  .faqp__wrap { max-width: calc(74ch + 2 * var(--gutter)); }
  .faqp__crumb { margin-bottom: 1.5rem; }
  .faqp__crumb a { color: var(--ink-mute); text-decoration: none; }
  .faqp__crumb a:hover { color: var(--ink); }
  .faqp__head { margin-bottom: clamp(2rem, 5vw, 3rem); }
  .faqp__h1 { margin: 0.2em 0 0.5em; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.05; }
  .faqp__lede { margin: 0; max-width: 60ch; }

  .faqp__list { margin: 0; }
  .faqp__item { padding: clamp(1.4rem, 3vw, 1.9rem) 0; border-top: 1px solid var(--line-soft); }
  .faqp__item:last-child { border-bottom: 1px solid var(--line-soft); }
  .faqp__q {
    margin: 0 0 0.5em; font-family: var(--serif); font-weight: 400;
    font-size: clamp(1.2rem, 2.2vw, 1.55rem); line-height: 1.2; color: var(--ink);
  }
  .faqp__a { margin: 0; color: var(--ink-soft); font-size: 1.05rem; line-height: 1.65; max-width: 68ch; }

  .faqp__glossary { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .faqp__gloss-h { font-size: clamp(1.6rem, 3.4vw, 2.3rem); margin: 0 0 0.3em; }
  .faqp__gloss-intro { margin: 0 0 1.5rem; max-width: 60ch; }
  .faqp__gloss-list { margin: 0; }
  .faqp__gloss-item { padding: clamp(1rem, 2.2vw, 1.35rem) 0; border-top: 1px solid var(--line-soft); scroll-margin-top: 90px; }
  .faqp__gloss-item:target {
    background: color-mix(in srgb, var(--cyan) 12%, transparent);
    box-shadow: inset 3px 0 0 var(--cyan);
    border-radius: 0 6px 6px 0;
  }
  .faqp__gloss-item:target .faqp__term { color: var(--cyan); }
  .faqp__gloss-item:last-child { border-bottom: 1px solid var(--line-soft); }
  .faqp__term {
    margin: 0 0 0.3em; font-family: var(--sans); font-weight: 600;
    font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink);
  }
  .faqp__def { margin: 0; color: var(--ink-soft); font-size: 1rem; line-height: 1.6; max-width: 68ch; }

  .faqp__explore { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .faqp__explore-h {
    font-family: var(--sans); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--ink-soft); margin: 0 0 1.1rem;
  }
  .faqp__explore ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
</style>
