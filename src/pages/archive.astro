---
import BaseLayout from '../layouts/BaseLayout.astro';
import RansomHeading from '../components/RansomHeading.astro';
import ArchiveCorridor from '../components/archive/ArchiveCorridor.astro';
import ArchivePanel from '../components/archive/ArchivePanel.astro';
import mediaJson from '../data/media.json';
import thumbSizesJson from '../data/thumb-sizes.json';
import { site } from '../data/site';
import { personLd, breadcrumbLd } from '../data/jsonld';
import {
  sortedReleases,
  releaseYear,
  formatReleaseDate,
  CONTRACT_LABEL,
  KIND_LABEL,
  releasePlatforms,
  releaseChains,
  releaseSeries,
  releaseKinds,
  type Release,
} from '../data/releases';

const desc = `Coldie has minted crypto art on Ethereum since May 2018, starting with the first stereoscopic artwork on a blockchain. Explore all ${sortedReleases.length} releases, their collectors and sales.`;

const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Coldie — digital archive',
  description: desc,
  url: `${site.url}/archive`,
  creator: { '@id': `${site.url}/#person` },
  temporalCoverage: `2018/${new Date().getFullYear()}`,
  variableMeasured: ['release date', 'edition size', 'platform', 'chain', 'last sale', 'listing price'],
};

// Continuous run of years 2018 → this year, so gaps stay visible.
const FIRST_YEAR = 2018;
const thisYear = new Date().getFullYear();
const years = Array.from({ length: thisYear - FIRST_YEAR + 1 }, (_, i) => FIRST_YEAR + i);
const byYear = new Map<number | null, Release[]>();
for (const r of sortedReleases) {
  const y = releaseYear(r);
  byYear.set(y, [...(byYear.get(y) ?? []), r]);
}
const groups: { key: string; label: string; items: Release[] }[] = [
  ...years.map((y) => ({ key: String(y), label: String(y), items: byYear.get(y) ?? [] })),
  ...(byYear.get(null)?.length ? [{ key: 'tbc', label: 'Date tbc', items: byYear.get(null)! }] : []),
];
const maxCount = Math.max(...groups.map((g) => g.items.length), 1);

const totalTokens = sortedReleases.reduce((n, r) => n + (r.supply ?? 0), 0);
const dated = sortedReleases.filter((r) => r.date);
import thumbsJson from '../data/thumbs.json';
import marketJson from '../data/market.json';
import { works } from '../data/works';
const thumbs: Record<string, string> = thumbsJson;

type Price = { amount: number; symbol: string; usd: number | null };
type Owner = { address: string; name: string | null; username: string | null; ens: string | null; artist: boolean };
type Market = {
  owner?: Owner | null;
  description: string | null;
  lastSale: (Price & { date?: string | null }) | null;
  listing: (Price & { kind: 'buy' | 'floor' | 'reserve' | 'auction' }) | null;
};
const market = marketJson.releases as Record<string, Market>;
const marketAsOf = formatReleaseDate(marketJson.fetchedAt);
const captions = new Map(works.map((w) => [w.slug, w.caption]));
const description = (r: Release) =>
  r.description ?? market[r.id]?.description ?? (r.slug ? captions.get(r.slug) : undefined) ?? null;

const fmtEth = (p: Price) =>
  `${p.amount.toLocaleString('en-US', { maximumFractionDigits: p.amount < 1 ? 4 : 2 })} ${p.symbol}`;
const fmtUsd = (usd: number | null) => (usd ? `≈ $${usd.toLocaleString('en-US')}` : '');
const LISTING_LABEL = { buy: 'For sale', floor: 'Floor', reserve: 'Reserve auction', auction: 'Live auction' };
const shortAddr = (a: string) => `${a.slice(0, 6)}…${a.slice(-4)}`;
/** Collector profile: SuperRare for SuperRare pieces with a username, else OpenSea. */
const ownerUrl = (r: Release, o: Owner) =>
  r.source === 'superrare' && o.username ? `https://superrare.com/${o.username}` : `https://opensea.io/${o.address}`;
const ownerLabel = (o: Owner) => o.ens ?? (o.name && !o.name.startsWith('0x') ? o.name : shortAddr(o.address));
const collectorCount = new Set(
  Object.values(market).flatMap((m) => (m.owner && !m.owner.artist ? [m.owner.address] : []))
).size;
// "On the record" facts, computed from the data so they stay accurate
const BONHAMS_LOT =
  'https://www.bonhams.com/auction/27285/lot/1/coldie-b-1982-proof-of-work-genesis-conceived-2018-minted-june-16-2021/';
const sales = sortedReleases.flatMap((r) => (market[r.id]?.lastSale ? [{ r, amount: market[r.id].lastSale!.amount }] : []));
const bigSales = sales.filter((x) => x.amount >= 10).length;
const topSale = sales.sort((a, b) => b.amount - a.amount)[0];
const forSaleCount = sortedReleases.filter((r) => market[r.id]?.listing).length;

/** Marketplace name for a listing URL. */
const marketName = (url: string) =>
  url.includes('superrare.com') ? 'SuperRare'
  : url.includes('opensea.io') ? 'OpenSea'
  : url.includes('deca.art') ? 'Deca'
  : url.includes('rareart.io') ? 'R.A.R.E. Art Labs'
  : new URL(url).hostname.replace(/^www\./, '');

/** Descriptive alt text: what the work is, by whom, when — read by image search and AI. */
const KIND_PHRASE: Record<string, string> = {
  '1/1': '1/1 digital artwork',
  edition: 'digital edition',
  generative: 'generative art collection',
  wearable: 'digital wearable',
  programmable: 'programmable artwork',
  tbc: 'digital artwork',
};
const altText = (r: Release) =>
  `${r.title} — ${r.burned ? 'burned ' : ''}${KIND_PHRASE[r.kind] ?? 'digital artwork'} by Coldie` +
  `${r.date ? ` (${r.date.slice(0, 4)})` : ''}${r.series && r.series !== 'Landmark' ? `, ${r.series} series` : ''}`;

// One record per work for the corridor, grid and detail panel (description is read
// from the list view's DOM instead of being duplicated here).
const media = mediaJson as Record<string, { src: string; type: 'video' | 'gif' } | null>;
const sizes = thumbSizesJson as Record<string, [number, number]>;
const archiveItems = sortedReleases.map((r) => {
  const mk = market[r.id];
  const o = mk?.owner;
  return {
    id: r.id,
    title: r.title,
    alt: altText(r),
    date: formatReleaseDate(r.date),
    year: String(releaseYear(r) ?? 'tbc'),
    img: thumbs[r.id] ?? null,
    size: sizes[r.id] ?? null,
    media: media[r.id] ?? null,
    kind: `${KIND_LABEL[r.kind]}${r.supply != null && r.kind !== '1/1' ? ` · ${r.supply.toLocaleString('en-US')}` : ''}`,
    series: r.series ?? null,
    platform: r.platform,
    chain: r.chain,
    badge: r.badge ?? null,
    url: r.url ?? null,
    market: r.url ? marketName(r.url) : null,
    slug: r.slug ?? null,
    owner: o ? { label: ownerLabel(o), href: ownerUrl(r, o), artist: o.artist, addr: shortAddr(o.address), address: o.address } : null,
    sale: mk?.lastSale ? `${fmtEth(mk.lastSale)}${mk.lastSale.date ? ` · ${formatReleaseDate(mk.lastSale.date)}` : ''}` : null,
    listing: mk?.listing ? { label: LISTING_LABEL[mk.listing.kind], price: fmtEth(mk.listing), usd: fmtUsd(mk.listing.usd) } : null,
    price: mk?.listing?.amount ?? null,
    burned: !!r.burned,
    related: r.related ?? null,
  };
});

// ── Structured data: every work as a VisualArtwork by Coldie ──
const absolute = (p: string) => new URL(p, site.url).href;
const clip = (t: string, n = 300) => (t.length > n ? `${t.slice(0, n).replace(/\s+\S*$/, '')}…` : t);
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Coldie — complete archive of digital releases, 2018 to today',
  description: desc,
  url: `${site.url}/archive`,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: sortedReleases.length,
  itemListElement: sortedReleases.map((r, i) => {
    const mk = market[r.id];
    const d = description(r);
    const art: Record<string, unknown> = {
      '@type': 'VisualArtwork',
      '@id': `${site.url}/archive#w-${r.id}`,
      name: r.title,
      creator: { '@id': `${site.url}/#person` },
      artform: 'Digital art (NFT)',
      artMedium: `${KIND_PHRASE[r.kind] ?? 'digital artwork'} on ${r.chain}`,
      url: `${site.url}/archive#w-${r.id}`,
    };
    if (r.date) art.dateCreated = r.date;
    if (thumbs[r.id]) art.image = absolute(thumbs[r.id]);
    if (r.supply) art.artEdition = r.supply;
    if (r.series && r.series !== 'Landmark') art.isPartOf = { '@type': 'CreativeWorkSeries', name: r.series, creator: { '@id': `${site.url}/#person` } };
    if (d) art.description = clip(d);
    if (r.url) art.sameAs = r.url;
    if (r.slug) art.mainEntityOfPage = `${site.url}/work/${r.slug}`;
    if (mk?.listing && r.url)
      art.offers = { '@type': 'Offer', price: mk.listing.amount, priceCurrency: 'ETH', availability: 'https://schema.org/InStock', url: r.url };
    return { '@type': 'ListItem', position: i + 1, item: art };
  }),
};

const searchText = (r: Release) =>
  [
    r.title, r.series, r.platform, r.chain, KIND_LABEL[r.kind], r.kindNote, r.notes, r.badge,
    r.date, formatReleaseDate(r.date), r.contract, r.contract && CONTRACT_LABEL[r.contract.toLowerCase()], r.tokenId,
    ...(r.variants ?? []).flatMap((v) => [v.title, v.tokenId]),
    description(r),
    market[r.id]?.owner?.ens, market[r.id]?.owner?.name, market[r.id]?.owner?.address,
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
---
<BaseLayout
  title="Crypto Art Pioneer Since 2018 — Complete NFT Archive"
  description={desc}
  path="/archive"
  ogImage="/og/archive.png"
  jsonld={[personLd(), datasetLd, itemListLd, breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'Archive', path: '/archive' },
  ])]}
>
  <section class="rel" data-view="list">
    <script is:inline>
      // Before first paint: the corridor (followed by the full list) on desktop;
      // just the list on phones, with reduced motion, or without JavaScript.
      (function () {
        var s = document.currentScript.parentElement;
        var calm = matchMedia('(prefers-reduced-motion: reduce)').matches || innerWidth < 900;
        if (!calm && new URLSearchParams(location.search).get('view') !== 'list') s.dataset.view = 'corridor';
      })();
    </script>
    <script type="application/json" id="arc-data" set:html={JSON.stringify(archiveItems)} />
    <div class="wrap">
      <nav class="small muted rel__crumb" aria-label="Breadcrumb"><a href="/">Home</a> · <span>Archive</span></nav>
      <div class="rel__top">
      <header class="rel__head">
        <p class="eyebrow">Digital releases · {FIRST_YEAR}–{thisYear}</p>
        <RansomHeading as="h1" text="Archive" />
        <p class="lede">
          Coldie has minted art on the blockchain since May 7, 2018, when
          <a href="/work/the-day-weve-all-been-waiting-for"><em>The Day We’ve All Been Waiting For</em></a> became the first
          stereoscopic artwork recorded on-chain. This is the complete record: every release from R.A.R.E. Art Labs and
          early SuperRare to today, with its collectors and sales.
        </p>
      </header>

      <dl class="rel__stats">
        <div><dt>Releases</dt><dd>{sortedReleases.length}</dd></div>
        <div><dt>Tokens logged</dt><dd>{totalTokens.toLocaleString('en-US')}</dd></div>
        <div><dt>First</dt><dd>{formatReleaseDate(dated[0]?.date)}</dd></div>
        <div><dt>Latest</dt><dd>{formatReleaseDate(dated.at(-1)?.date)}</dd></div>
        <div><dt>Platforms</dt><dd>{releasePlatforms.length}</dd></div>
        <div><dt>1/1 collectors</dt><dd>{collectorCount}</dd></div>
      </dl>
      </div>



      <div class="rel__layout">
        <aside class="rel__side" aria-label="Filter releases">
          <div class="rel__controls" role="search">
            <label class="rel__search">
              <span class="sr-only">Search releases</span>
              <input type="search" id="rel-q" placeholder="Search" title="Title, series, collector, contract or token ID" autocomplete="off" />
            </label>
            <label class="rel__filter">
              <span>Type</span>
              <select id="rel-kind">
                <option value="">All</option>
                {releaseKinds.map((k) => <option value={k}>{KIND_LABEL[k]}</option>)}
              </select>
            </label>
            <label class="rel__filter">
              <span>Series</span>
              <select id="rel-series">
                <option value="">All</option>
                {releaseSeries.map((s) => <option value={s}>{s}</option>)}
              </select>
            </label>
            <label class="rel__filter">
              <span>Platform</span>
              <select id="rel-platform">
                <option value="">All</option>
                {releasePlatforms.map((p) => <option value={p}>{p}</option>)}
              </select>
            </label>
            <label class="rel__filter">
              <span>Chain</span>
              <select id="rel-chain">
                <option value="">All</option>
                {releaseChains.map((c) => <option value={c}>{c}</option>)}
              </select>
            </label>
            <label class="rel__filter rel__check">
              <input type="checkbox" id="rel-forsale" />
              <span>For sale only ({forSaleCount})</span>
            </label>
            <label class="rel__filter">
              <span>Sort</span>
              <select id="rel-sort">
                <option value="oldest">Oldest first</option>
                <option value="newest">Newest first</option>
                <option value="price-asc" disabled data-price-sort>Price: low → high</option>
                <option value="price-desc" disabled data-price-sort>Price: high → low</option>
              </select>
              <small class="rel__hint" id="rel-sort-hint">Check “For sale only” to sort by price.</small>
            </label>
          </div>
          <p class="rel__colltag" id="rel-collector" hidden>
            <span>Collector</span>
            <strong data-label></strong>
            <button type="button" data-clear aria-label="Clear collector filter">×</button>
          </p>
          <p class="rel__count small muted" aria-live="polite">
            <span id="rel-shown">{sortedReleases.length}</span> of {sortedReleases.length} releases
            <button type="button" id="rel-reset" class="rel__reset" hidden>Clear filters</button>
          </p>
        </aside>
        <div class="rel__main">
          <nav class="rel__rail" aria-label="Jump to year">
            {groups.map((g) => (
              <a href={`#y-${g.key}`} class="rel__railyear" data-rail={g.key} aria-label={`${g.label}: ${g.items.length} releases`}>
                <span class="rel__bar" style={`--h:${(g.items.length / maxCount) * 100}%`}></span>
                <span class="rel__railcount" data-rail-count>{g.items.length}</span>
                <span class="rel__raillabel">{g.key === 'tbc' ? 'tbc' : `’${g.label.slice(2)}`}</span>
              </a>
            ))}
          </nav>

          <ArchiveCorridor />

          <section class="arc-record" aria-labelledby="arc-record-title">
            <h2 id="arc-record-title">A crypto art pioneer, on the record</h2>
            <ul>
              <li>
                <strong>First on-chain, May 7, 2018.</strong>
                <a href="/work/the-day-weve-all-been-waiting-for"><em>The Day We’ve All Been Waiting For</em></a> is the first
                stereoscopic artwork recorded on a blockchain. One of its two editions is held by Coinbase and was on display in
                its lobby from 2018 to 2020.
              </li>
              <li>
                <strong>On SuperRare since July 24, 2018.</strong>
                <a href="#w-sr-41a322-501" class="rel__related-plain"><em>Decentral Eyes — Vitalik Buterin — Variant 01</em></a> is
                token #501 on SuperRare’s original contract.
              </li>
              <li>
                <strong>Pioneers at auction.</strong>
                <a href="/work/proof-of-work-genesis"><em>Proof of Work — Genesis</em></a>, first tokenized in 2018, was
                <a href={BONHAMS_LOT} target="_blank" rel="noopener">Lot 1</a> of the Bonhams × SuperRare sale
                <em>CryptOGs: The Pioneers of NFT Art</em> (2021). Works have also sold at
                <a href="/work/3d-light-painting-03">Sotheby’s</a> (2022) and
                <a href="/work/warren-buffett-filthy-fiat">Christie’s</a> (2024).
              </li>
              <li>
                <strong>Collected.</strong> {collectorCount} collectors hold Coldie’s 1/1s, including Raoul Pal,
                Batsoupyum, Nick Tomaino, Coinbase, the 6529 Fund, and whalevault.eth. {bigSales} works last sold for 10 ETH or more, the highest at
                {topSale ? fmtEth(market[topSale.r.id].lastSale!) : ''} for
                <a href={`#w-${topSale?.r.id}`} class="rel__related-plain"><em>{topSale?.r.title}</em></a>{
                  /snoop dogg/i.test(topSale?.r.badge ?? '') ? ', an official collaboration with Snoop Dogg' : ''
                }.
              </li>
              <li>
                <strong>{sortedReleases.length} releases, {FIRST_YEAR} to today,</strong> across R.A.R.E. Art Labs, SuperRare,
                Nifty Gateway, ASYNC, MakersPlace, The Memes by 6529 and OpenSea.
              </li>
            </ul>
          </section>


          <div class="arc-list" id="rel-list">
          <ol class="rel__timeline" id="rel-timeline">
            {groups.map((g) => (
              <li class="rel__year" id={`y-${g.key}`} data-year={g.key}>
                <h2 class="rel__yearlabel">
                  {g.label}
                  <span class="rel__yearcount"><span data-year-count>{g.items.length}</span> {g.items.length === 1 ? 'release' : 'releases'}</span>
                </h2>
                {g.items.length === 0 && <p class="rel__gap muted small" data-gap>Nothing logged for {g.label} yet.</p>}
                <ol class="rel__entries">
                  {g.items.map((r) => (
                    <li
                      class="rel__entry"
                      id={`w-${r.id}`}
                      data-entry
                      data-id={r.id}
                      data-search={searchText(r)}
                      data-kind={r.kind}
                      data-series={r.series ?? ''}
                      data-platform={r.platform}
                      data-chain={r.chain}
                      data-forsale={market[r.id]?.listing ? '1' : undefined}
                      data-owner={market[r.id]?.owner?.address}
                      data-price={market[r.id]?.listing?.amount}
                      data-year={g.key}
                    >
                      <time class="rel__date" datetime={r.date ?? undefined}>{formatReleaseDate(r.date)}</time>
                      <div class="rel__card">
                        {thumbs[r.id]
                          ? (
                            <a class="rel__thumb" href={r.url ?? (r.slug && `/work/${r.slug}`)} target={r.url ? '_blank' : undefined} rel="noopener" tabindex="-1" aria-hidden="true">
                              <img src={thumbs[r.id]} alt={altText(r)} loading="lazy" decoding="async" width="112" height="112" />
                              {r.burned && <span class="burn-stamp">Burned</span>}
                            </a>
                          )
                          : <span class="rel__thumb rel__thumb--empty" aria-hidden="true">No image</span>}
                        <div class="rel__body">
                        <h3 class="rel__title">
                          {r.slug ? <a href={`/work/${r.slug}`}>{r.title}</a> : r.title}
                        </h3>
                        {r.badge && <p class="rel__badge">{r.badge}</p>}
                        <ul class="rel__chips">
                          <li class={`rel__chip rel__chip--${r.kind === '1/1' ? 'one' : r.kind}`}>
                            {KIND_LABEL[r.kind]}{r.kindNote && r.kindNote !== r.kind ? ` · ${r.kindNote}` : ''}
                          </li>
                          {r.supply != null && r.kind !== '1/1' && <li class="rel__chip">Supply {r.supply.toLocaleString('en-US')}</li>}
                          {r.series && <li class="rel__chip">{r.series}</li>}
                          <li class="rel__chip">{r.platform}</li>
                          <li class="rel__chip">{r.chain}</li>
                          {r.confirm && <li class="rel__chip rel__chip--confirm">Details to confirm</li>}
                        </ul>
                        {market[r.id]?.owner && (
                      <p class="rel__collector">
                        <span class="rel__collectorlabel">{market[r.id].owner!.artist ? 'Held by the artist' : 'Collector'}</span>
                        <button type="button" class="rel__collectorbtn" data-collector={market[r.id].owner!.address} data-collector-label={ownerLabel(market[r.id].owner!)} title={`Show everything held by ${ownerLabel(market[r.id].owner!)}`}>
                          {ownerLabel(market[r.id].owner!)}
                        </button>
                        <a class="rel__collectorext" href={ownerUrl(r, market[r.id].owner!)} target="_blank" rel="noopener" aria-label={`${ownerLabel(market[r.id].owner!)} profile`} title={market[r.id].owner!.address}>↗</a>
                        {ownerLabel(market[r.id].owner!) !== shortAddr(market[r.id].owner!.address) && (
                          <span class="rel__addr">{shortAddr(market[r.id].owner!.address)}</span>
                        )}
                      </p>
                    )}
                    {r.notes && <p class="rel__notes small muted">{r.notes}</p>}
                    {(r.url || r.links?.length || r.related) && (
                      <p class="rel__links small">
                        {r.url && <a class="rel__market" href={r.url} target="_blank" rel="noopener">View on {marketName(r.url)} ↗</a>}
                        {r.links?.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}
                        {r.related && <a class="rel__related" href={`#w-${r.related.id}`}>See {r.related.label} →</a>}
                      </p>
                    )}
                    {r.variants?.length && (
                      <details class="rel__variants">
                        <summary>{r.variants.length} {r.variants.length === 1 ? 'piece' : 'pieces'} in this release</summary>
                        <ul>
                          {r.variants.map((v) => (
                            <li>
                              <span class="rel__vtitle">
                                {v.url ? <a href={v.url} target="_blank" rel="noopener">{v.title} ↗</a> : v.title}
                              </span>
                              <span class="rel__vmeta muted">
                                {[
                                  v.kind && (v.kind === '1/1' ? '1/1' : KIND_LABEL[v.kind]),
                                  v.supply != null && v.supply !== 1 ? `×${v.supply}` : null,
                                  v.date && v.date !== r.date ? formatReleaseDate(v.date) : null,
                                  v.tokenId && v.tokenId.length < 14 ? `#${v.tokenId}` : null,
                                ].filter(Boolean).join(' · ')}
                              </span>
                            </li>
                          ))}
                        </ul>
                      </details>
                    )}
                    </div>
                    <div class="rel__desc">
                      {description(r)
                        ? (
                          <>
                            <p class="rel__desctext" data-desc>{description(r)}</p>
                            <button type="button" class="rel__more" data-more hidden>More</button>
                          </>
                        )
                        : <p class="rel__desctext muted">No description.</p>}
                    </div>
                    <dl class="rel__marketcol">
                      <div class="rel__stat">
                        <dt>Last sale</dt>
                        {market[r.id]?.lastSale
                          ? <dd>{fmtEth(market[r.id].lastSale!)}{market[r.id].lastSale!.date && <span>{formatReleaseDate(market[r.id].lastSale!.date)}</span>}</dd>
                          : <dd class="muted">—</dd>}
                      </div>
                      <div class="rel__stat">
                        <dt>{market[r.id]?.listing ? LISTING_LABEL[market[r.id].listing!.kind] : 'For sale'}</dt>
                        {market[r.id]?.listing
                          ? <dd class="rel__price">{fmtEth(market[r.id].listing!)}<span>{fmtUsd(market[r.id].listing!.usd)}</span></dd>
                          : <dd class="muted">Not listed</dd>}
                      </div>
                    </dl>
                  </div>
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>
