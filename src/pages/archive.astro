<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const q = $<HTMLInputElement>('rel-q');
  const selects = ['kind', 'series', 'platform', 'chain'].map((k) => [k, $<HTMLSelectElement>(`rel-${k}`)] as const);
  const forSale = $<HTMLInputElement>('rel-forsale');
  const sort = $<HTMLSelectElement>('rel-sort');
  const sortHint = $('rel-sort-hint');
  const priceOptions = Array.from(sort.querySelectorAll<HTMLOptionElement>('[data-price-sort]'));
  const reset = $<HTMLButtonElement>('rel-reset');
  const timeline = $<HTMLOListElement>('rel-timeline');
  const flat = $<HTMLOListElement>('rel-flat');
  const rail = document.querySelector<HTMLElement>('.rel__rail')!;
  const empty = $('rel-empty');
  const shown = $('rel-shown');
  const years = Array.from(timeline.querySelectorAll<HTMLElement>('.rel__year'));
  const entries = Array.from(timeline.querySelectorAll<HTMLElement>('[data-entry]'));
  const home = new Map(entries.map((e) => [e, e.parentElement!]));

  // ── Collector filter: click a collector's name to see everything they hold ──
  let collector = '';
  const collTag = $('rel-collector');
  function setCollector(address: string, label: string, from: 'list' | 'panel' | 'link' = 'list') {
    collector = address.toLowerCase();
    collTag.querySelector('[data-label]')!.textContent = label;
    collTag.hidden = !collector;
    const url = new URL(location.href);
    if (collector) url.searchParams.set('collector', collector);
    else url.searchParams.delete('collector');
    history.replaceState(null, '', url);
    apply();
    // land at the start of the results: the corridor from the panel, the list from the list
    if (from === 'list') listTop();
    else if (from === 'panel') document.getElementById('arc-corridor')?.scrollIntoView({ behavior: 'instant' as ScrollBehavior });
  }
  const listTop = () => {
    const l = document.getElementById('rel-list');
    if (l) scrollTo({ top: l.getBoundingClientRect().top + scrollY - 80, behavior: 'instant' as ScrollBehavior });
  };
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-collector]');
    if (!btn) return;
    e.preventDefault();
    const fromPanel = !!btn.closest('dialog');
    (btn.closest('dialog') as HTMLDialogElement | null)?.close();
    setCollector(btn.dataset.collector!, btn.dataset.collectorLabel ?? btn.textContent!.trim(), fromPanel ? 'panel' : 'list');
  });
  collTag.querySelector('[data-clear]')!.addEventListener('click', () => setCollector('', ''));

  function apply() {
    const terms = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    const active = selects.filter(([, el]) => el.value);
    const filtering = terms.length > 0 || active.length > 0 || forSale.checked || !!collector;
    const perYear = new Map<string, number>();
    let total = 0;

    for (const entry of entries) {
      const d = entry.dataset;
      const ok =
        terms.every((t) => d.search!.includes(t)) &&
        active.every(([k, el]) => d[k] === el.value) &&
        (!forSale.checked || d.forsale === '1') &&
        (!collector || d.owner === collector);
      entry.hidden = !ok;
      if (ok) {
        total++;
        perYear.set(d.year!, (perYear.get(d.year!) ?? 0) + 1);
      }
    }

    for (const year of years) {
      const n = perYear.get(year.dataset.year!) ?? 0;
      // While filtering, hide years with no matches; otherwise keep empty years as visible gaps.
      year.hidden = filtering && n === 0;
      year.querySelector('[data-year-count]')!.textContent = String(n);
      const bar = rail.querySelector<HTMLElement>(`[data-rail="${year.dataset.year}"]`);
      if (bar) {
        bar.querySelector('[data-rail-count]')!.textContent = String(n);
        bar.toggleAttribute('data-empty', n === 0);
        bar.hidden = filtering && n === 0;
      }
    }
    shown.textContent = String(total);
    empty.hidden = total > 0;
    reset.hidden = !filtering && sort.value === 'oldest';
    announce();
  }

  /** Tell the corridor and grid which works match, in display order. */
  function announce() {
    const byPrice = sort.value.startsWith('price');
    let list = entries.filter((e) => !e.hidden);
    if (byPrice) {
      const dir = sort.value === 'price-asc' ? 1 : -1;
      list = list.sort((a, b) => dir * (Number(a.dataset.price) - Number(b.dataset.price)));
    } else if (sort.value === 'newest') {
      list = list.reverse();
    }
    document.dispatchEvent(
      new CustomEvent('archive:results', { detail: { ids: list.map((e) => e.dataset.id!), byPrice } })
    );
  }

  /** Timeline by date, or one flat list by listing price (price sorts need "For sale only"). */
  function layout() {
    priceOptions.forEach((o) => (o.disabled = !forSale.checked));
    sortHint.hidden = forSale.checked;
    if (!forSale.checked && sort.value.startsWith('price')) sort.value = 'oldest';

    const byPrice = sort.value.startsWith('price');
    timeline.toggleAttribute('data-newest', sort.value === 'newest');
    if (byPrice) {
      const dir = sort.value === 'price-asc' ? 1 : -1;
      const price = (e: HTMLElement) => Number(e.dataset.price);
      entries
        .filter((e) => e.dataset.price)
        .sort((a, b) => dir * (price(a) - price(b)))
        .forEach((e) => flat.append(e));
    } else {
      entries.forEach((e) => home.get(e)!.append(e)); // back into their years, original order
    }
    timeline.hidden = byPrice;
    flat.hidden = !byPrice;
    rail.hidden = byPrice;
  }

  const update = () => {
    layout();
    apply();
  };
  q.addEventListener('input', apply);
  selects.forEach(([, el]) => el.addEventListener('change', apply));
  forSale.addEventListener('change', update);
  sort.addEventListener('change', update);
  reset.addEventListener('click', () => {
    q.value = '';
    selects.forEach(([, el]) => (el.value = ''));
    forSale.checked = false;
    sort.value = 'oldest';
    setCollector('', '');
    update();
  });

  // Deep links: /archive?q=Snowden pre-fills the search (used by series and subject pages);
  // /archive?collector=0x… shows one collector's works.
  const params = new URLSearchParams(location.search);
  const initial = params.get('q');
  if (initial) q.value = initial;
  const initialCollector = params.get('collector')?.toLowerCase();
  if (initialCollector) {
    const btn = document.querySelector<HTMLElement>(`[data-collector="${CSS.escape(initialCollector)}"]`);
    collector = initialCollector;
    collTag.querySelector('[data-label]')!.textContent = btn?.dataset.collectorLabel ?? `${initialCollector.slice(0, 6)}…`;
    collTag.hidden = false;
  }

  // Year bar: in the corridor, jump straight to that year; otherwise anchor into the list.
  const section = document.querySelector<HTMLElement>('.rel')!;
  rail.addEventListener('click', (e) => {
    const bar = (e.target as HTMLElement).closest<HTMLElement>('[data-rail]');
    if (!bar || section.dataset.view !== 'corridor') return;
    e.preventDefault();
    document.dispatchEvent(new CustomEvent('archive:jump-year', { detail: bar.dataset.rail! }));
  });

  // "See …" links between related works jump straight to that entry in the list.
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a.rel__related');
    if (!a) return;
    const el = document.querySelector<HTMLElement>(a.getAttribute('href')!);
    if (!el) return;
    e.preventDefault();
    scrollTo({ top: el.getBoundingClientRect().top + scrollY - 120, behavior: 'instant' as ScrollBehavior });
    el.removeAttribute('data-flash');
    void el.offsetWidth;
    el.setAttribute('data-flash', '');
  });

  // ── Year jump list for the detailed list ─────────────────
  const listNav = $('arc-listyears');
  const listEl = $('rel-list');
  const navBtns = [...listNav.querySelectorAll<HTMLButtonElement>('[data-year]')];
  // show it only while the list (not the corridor) fills the screen
  new IntersectionObserver(([e]) => listNav.toggleAttribute('data-show', e.isIntersecting), {
    rootMargin: '-45% 0px -45% 0px',
  }).observe(listEl);
  // highlight the year being read
  const yearSeen = new IntersectionObserver(
    (es) => {
      for (const e of es) {
        if (!e.isIntersecting) continue;
        const y = (e.target as HTMLElement).dataset.year;
        navBtns.forEach((b) => b.setAttribute('aria-current', String(b.dataset.year === y)));
      }
    },
    { rootMargin: '-35% 0px -60% 0px' }
  );
  years.forEach((y) => yearSeen.observe(y));
  listNav.addEventListener('click', (e) => {
    const y = (e.target as HTMLElement).closest<HTMLElement>('[data-year]')?.dataset.year;
    const target = y && document.getElementById(`y-${y}`);
    if (target) scrollTo({ top: target.getBoundingClientRect().top + scrollY - 80, behavior: 'instant' as ScrollBehavior });
  });
  // follow the filters: years with no matching works drop out
  document.addEventListener('archive:results', () => {
    for (const b of navBtns) b.hidden = !!years.find((y) => y.dataset.year === b.dataset.year)?.hidden;
    listNav.hidden = sort.value.startsWith('price'); // a price-sorted list has no years
  });

  // let the corridor script attach its listeners before the first results
  setTimeout(update, 0);

  // Descriptions clamp to five lines; offer "More" only where text is actually cut off.
  for (const text of document.querySelectorAll<HTMLElement>('[data-desc]')) {
    const btn = text.nextElementSibling as HTMLButtonElement;
    const wrap = text.parentElement!;
    const check = () => (btn.hidden = !wrap.hasAttribute('data-open') && text.scrollHeight <= text.clientHeight + 1);
    btn.addEventListener('click', () => {
      const open = wrap.toggleAttribute('data-open');
      btn.textContent = open ? 'Less' : 'More';
      check();
    });
    new ResizeObserver(check).observe(text);
  }
</script>
