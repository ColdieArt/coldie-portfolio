---
// Homepage: the art first. Every work as a browsable wall (see components/gallery);
// the series, exhibitions and story live on /studio.
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtFirst from '../components/gallery/ArtFirst.astro';
import { personLd, websiteLd } from '../data/jsonld';
---
<BaseLayout
  title="Coldie — Stereoscopic 3D Crypto Art Since 2018"
  description="Coldie is a stereoscopic 3D artist who minted the first 3D artwork on a blockchain in May 2018. Browse the collection: Decentral Eyes, kinetic portraits and every work since."
  path="/"
  jsonld={[websiteLd(), personLd()]}
>
  <script is:inline>
    // Old links to homepage sections (coldie3d.com/#filthy-fiat) now live on /studio.
    (function () {
      var old = ['featured-digital', 'current-series', 'en-marcha-interactive', 'filthy-fiat', 'provenance', 'work', 'pioneer', 'story', 'acquire', 'inquire-form', 'tech-epochalypse'];
      var h = location.hash.slice(1);
      if (h && old.indexOf(h) !== -1) location.replace('/studio#' + h);
    })();
  </script>
  <h1 class="sr-only">Coldie — stereoscopic 3D and crypto artist, on-chain since 2018.</h1>
  <ArtFirst />
</BaseLayout>
