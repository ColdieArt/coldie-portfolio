---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechEpochalypse from '../components/TechEpochalypse.astro';
import CurrentSeries from '../components/CurrentSeries.astro';
import EnMarcha from '../components/EnMarcha.astro';
import ProvenanceStrip from '../components/ProvenanceStrip.astro';
import Pillar from '../components/Pillar.astro';
import Story from '../components/Story.astro';
import Documentary from '../components/Documentary.astro';
import Pioneer from '../components/Pioneer.astro';
import FeaturedDigital from '../components/FeaturedDigital.astro';
import RansomHeading from '../components/RansomHeading.astro';
import FilthyFiat from '../components/FilthyFiat.astro';
import Acquire from '../components/Acquire.astro';
import { site } from '../data/site';
import { personLd, websiteLd } from '../data/jsonld';
import Crossroads from '../components/Crossroads.astro';
---
<BaseLayout
  title="Coldie — Stereoscopic 3D Crypto Art Since 2018"
  description="Coldie is a stereoscopic 3D artist who minted the first 3D artwork on a blockchain in May 2018. Explore Decentral Eyes, kinetic portraits and the full archive."
  path="/"
  jsonld={[websiteLd(), personLd()]}
>
  <h1 class="sr-only">Coldie — stereoscopic 3D and crypto artist, on-chain since 2018.</h1>

  <!-- Choose your own adventure: three doors, then the Studio -->
  <Crossroads />

  <div id="studio" class="studio-start" aria-hidden="true"></div>

  <!-- Tech Epochalypse -->
  <TechEpochalypse />

  <!-- Featured digital works — on-chain editions, collect on OpenSea -->
  <FeaturedDigital />

  <!-- Current Exhibition -->
  <CurrentSeries />

  <!-- En Marcha — interactive digital mural, embedded for on-site interaction -->
  <EnMarcha />

  <FilthyFiat />

  <ProvenanceStrip />

  <!-- 3. The work — three pillars -->
  <div id="work">
    <div class="wrap work__intro">
      <p class="eyebrow">The Thesis</p>
      <RansomHeading as="h2" class="work__h" lines={["Touch the art.", "Feel something."]} />
      <p class="lede work__lede">
        For years, I would bring my son to art museums and galleries. After years of continually saying
        “DON’T TOUCH THE ART,” this phrase stopped me in my tracks while in a gallery. Why am I keeping my
        child from experiencing art in the way he wants to? At that moment “TOUCH THE ART” was born, and I
        have been working toward this mantra to create art that can be interacted with in my own style of
        3D collage.
      </p>
    </div>
    <Pillar pillar="kinetic" index={1} />
  </div>

  <!-- Pioneer, on-chain — below Touch the Art -->
  <Pioneer />

  <!-- Front Row 3D — below the pioneer section -->
  <Documentary />

  <!-- Story -->
  <Story />

  <!-- Acquire / inquire -->
  <Acquire />
</BaseLayout>

<style>
  .work__intro { padding-top: clamp(3.5rem, 8vw, 6rem); max-width: 66ch; }
  .work__h { margin: 0 0 0.4em; }
  .work__lede { margin: 0 0 1em; }
  .work__lede2 { margin: 0; color: var(--ink-soft); }
  .studio-start { scroll-margin-top: 64px; }
</style>
