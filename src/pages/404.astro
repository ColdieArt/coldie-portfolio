---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not found" description="That page could not be found." path="/404">
  <section class="nf">
    <div class="wrap nf__wrap">
      <p class="eyebrow">404</p>
      <h1>That page is out of frame.</h1>
      <p class="lede">The work you’re looking for may have moved. Start from the beginning.</p>
      <div class="nf__cta">
        <a href="/" class="btn btn--solid">Back to home</a>
        <a href="/#work" class="btn">See the work</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .nf { min-height: 70vh; display: grid; place-items: center; }
  .nf__wrap { text-align: center; max-width: 50ch; }
  .nf__cta { display: flex; gap: 0.9rem; justify-content: center; margin-top: 1.5rem; }
</style>
