---
import '../styles/global.css';
import { site } from '../data/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  /** Path-relative canonical, e.g. "/work/foo". Defaults to current. */
  path?: string;
  /** OG image absolute or root-relative path. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** JSON-LD objects to embed (already schema.org-shaped). */
  jsonld?: Record<string, unknown>[];
  /** Keep a draft page out of search results (also excluded from the sitemap in astro.config). */
  noindex?: boolean;
  /** Use the wide layout on large screens (art gets the room; see global.css). */
  wide?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogImage = '/og/default.png',
  ogType = 'website',
  jsonld = [],
  noindex = false,
  wide = false,
} = Astro.props;

// One URL per page: no trailing slash (vercel.json trailingSlash: false redirects /x/ → /x).
const canonical = new URL(path === '/' ? path : path.replace(/\/$/, ''), site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
// Generated cards in /og/ are 1200×630 (scripts/build-og.mjs).
const ogIsCard = ogImage.startsWith('/og/');
// A title that already starts with the name (homepage) is used as-is.
const fullTitle = title === site.name ? `${site.name} — ${site.tagline}` : title.startsWith(`${site.name} — `) ? title : `${title} · ${site.name}`;
---

<!doctype html>
<html lang="en" data-wide={wide ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {ogIsCard && <meta property="og:image:width" content="1200" />}
    {ogIsCard && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={description} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#141414" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Punk display (Anton) + DIY typewriter (Special Elite), plus a ransom-note
        mix of serif/sans/slab faces for the collage headlines. swap-display. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo+Black&family=Google+Sans:wght@400;500;700&family=Oswald:wght@500;700&family=DM+Serif+Display&family=Playfair+Display:wght@900&family=Rye&family=Special+Elite&display=swap"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonld.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
